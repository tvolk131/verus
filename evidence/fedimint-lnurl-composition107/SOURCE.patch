+        Some(Self {
+            msats: self.msats.checked_add(other.msats)?,
+        })
+    }
+}
+#[verus_verify]
+impl PaymentFee {
+#[verus_spec(ensures Self::SEND_FEE_LIMIT.base.msats==100_000, Self::SEND_FEE_LIMIT.parts_per_million==15_000)]
