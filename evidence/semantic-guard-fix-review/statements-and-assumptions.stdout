       programs.typed_instr E L I
         (fancy_lists.hcons type_context.tctx_elt
            (type_context.TCtx_hasty (syn_type.uniq_borₛ ?𝔄) p
               (uniq_bor.uniq_bor κ ty))
            (fancy_lists.hnil type_context.tctx_elt)) p
         (fun v : lang.val =>
          fancy_lists.hcons type_context.tctx_elt
            (type_context.TCtx_hasty (syn_type.uniq_borₛ ?𝔄) p
               (uniq_bor.uniq_bor κ ty))
            (fancy_lists.hcons type_context.tctx_elt
               (type_context.TCtx_hasty syn_type.locₛ 
                  (lang.of_val v) pptr.ptr_ty)
               (fancy_lists.hnil type_context.tctx_elt)))
         (fun
            (post : fancy_lists.plist syn_type.indep_interp_of_syn_type
                      (syn_type.uniq_borₛ ?𝔄 :: syn_type.locₛ :: nil) ->
                    syn_type.Mask -> syn_type.proph_asn -> Prop)
            '{|
               fancy_lists.phd := m; fancy_lists.ptl := fancy_lists.nil_tt
             |} =>
          post
            {|
              fancy_lists.phd := m;
              fancy_lists.ptl :=
                {|
                  fancy_lists.phd := fst (uniq_bor.uniq_bor_loc m);
                  fancy_lists.ptl := fancy_lists.nil_tt
                |}
            |})
