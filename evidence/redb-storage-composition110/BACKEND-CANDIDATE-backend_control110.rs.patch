+pub open spec fn incorrect_closed_first(flags: Flags) -> Result<(), ProjectedError> {
+    if flags.closed { Err(ProjectedError::DatabaseClosed) }
+    else if flags.io_failed { Err(ProjectedError::PreviousIo) }
+    else { Ok(()) }
+}
