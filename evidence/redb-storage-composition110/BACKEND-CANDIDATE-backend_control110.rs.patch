+pub proof fn nonvacuous_witnesses()
+    ensures
+        !step(clean(), Choice { operation: Operation::BestEffort, backend: Err(17), effect: 91 }).after.io_failed,
+        step(clean(), Choice { operation: Operation::Write, backend: Err(17), effect: 91 }).after.io_failed,
+        step(clean(), Choice { operation: Operation::Sync, backend: Err(18), effect: 92 }).after.io_failed,
+        step(clean(), Choice { operation: Operation::Close, backend: Err(19), effect: 93 }).after.closed,
+        history(clean(), seq![
+            Choice { operation: Operation::Write, backend: Ok(()), effect: 1 },
+            Choice { operation: Operation::Sync, backend: Ok(()), effect: 2 },
+        ]).events.len() == 2,
+        !history(clean(), seq![
+            Choice { operation: Operation::Write, backend: Ok(()), effect: 1 },
+            Choice { operation: Operation::Sync, backend: Ok(()), effect: 2 },
+        ]).end.io_failed,
+        continuation(true, seq![
+            CallbackChoice { reply: Ok(()), effect: 37 },
+            CallbackChoice { reply: Err(ProjectedError::Corrupted(seq![4u8])), effect: 88 },
+            CallbackChoice { reply: Ok(()), effect: 99 },
+        ]).successful == 1,
+        continuation(true, seq![
+            CallbackChoice { reply: Ok(()), effect: 37 },
+            CallbackChoice { reply: Err(ProjectedError::Corrupted(seq![4u8])), effect: 88 },
+            CallbackChoice { reply: Ok(()), effect: 99 },
+        ]).effects == seq![37int, 88int],
+{
+    reveal_with_fuel(history, 4);
+    reveal_with_fuel(continuation, 4);
+    assert(seq![37int, 88int] =~= seq![37int] + seq![88int]);
+}
