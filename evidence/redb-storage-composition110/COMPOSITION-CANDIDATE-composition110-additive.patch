diff --git a/evidence/redb-storage-composition110/laneA/composition110.rs b/evidence/redb-storage-composition110/laneA/composition110.rs
new file mode 100644
--- /dev/null
+++ b/evidence/redb-storage-composition110/laneA/composition110.rs
@@ -0,0 +1,393 @@
+use vstd::prelude::*;
+#[path = "buffered_flush109.rs"]
+pub mod storage;
+#[path = "ack_cfg.rs"]
+pub mod acknowledgement;
+
+verus! {
+
+pub const HEADER_BYTES: usize = 320;
+
+pub struct Effect {
+    pub image: storage::Image,
+    pub pending: Seq<Seq<storage::Entry>>,
+}
+
+pub struct Action {
+    pub signal: int,
+    pub decisions: spec_fn(nat, nat) -> storage::Decision,
+    pub sync_ok: bool,
+    pub persisted: Set<int>,
+    pub effect: spec_fn(storage::Image, Seq<Seq<storage::Entry>>) -> Effect,
+}
+
+pub struct FlushRecord {
+    pub pc: int,
+    pub before: storage::Image,
+    pub pending: Seq<Seq<storage::Entry>>,
+    pub decisions: spec_fn(nat, nat) -> storage::Decision,
+    pub sync_ok: bool,
+    pub persisted: Set<int>,
+    pub result: storage::Run,
+}
+
+pub struct Product {
+    pub control: acknowledgement::State,
+    pub image: storage::Image,
+    pub pending: Seq<Seq<storage::Entry>>,
+    pub first_header: Seq<u8>,
+    pub second_header: Seq<u8>,
+    pub geometry: nat,
+    pub history: Seq<FlushRecord>,
+    pub first_index: int,
+    pub second_index: int,
+    pub blocked: bool,
+    pub rejected: Option<Effect>,
+}
+
+pub open spec fn initial(config: acknowledgement::Config, image: storage::Image,
+    pending: Seq<Seq<storage::Entry>>, first_header: Seq<u8>, second_header: Seq<u8>) -> Product {
+    Product { control: acknowledgement::initial(config), geometry: image.visible.len(),
+        image, pending, first_header, second_header, history: Seq::empty(),
+        first_index: -1, second_index: -1, blocked: false, rejected: None }
+}
+
+pub open spec fn storage_valid(state: Product) -> bool {
+    &&& storage::valid(state.image)
+    &&& storage::pending_valid(state.pending, state.geometry)
+    &&& state.image.visible.len() == state.geometry
+    &&& HEADER_BYTES <= state.geometry
+    &&& state.first_header.len() == HEADER_BYTES
+    &&& state.second_header.len() == HEADER_BYTES
+}
+
+pub open spec fn is_flush(state: Product) -> bool {
+    state.control.pc == 24 || state.control.pc == 28
+}
+
+pub open spec fn framed(state: Product, action: Action) -> bool {
+    let proposed = (action.effect)(state.image, state.pending);
+    proposed.image == state.image && proposed.pending == state.pending
+}
+
+pub open spec fn flushed(state: Product, action: Action) -> storage::Run {
+    storage::model_flush(state.image, state.pending, action.decisions,
+        action.sync_ok, action.persisted)
+}
+
+pub open spec fn generated_signal(state: Product, action: Action) -> int {
+    if state.control.status != 0 { 0 }
+    else if is_flush(state) { if flushed(state, action).ok { 0 } else { 1 } }
+    else if !framed(state, action) { 5 }
+    else { action.signal }
+}
+
+pub open spec fn header_pending(pending: Seq<Seq<storage::Entry>>, header: Seq<u8>) -> bool {
+    pending.len() > 0 && pending.last() == seq![storage::Entry { offset: 0, bytes: header }]
+}
+
+pub open spec fn record(state: Product, action: Action) -> FlushRecord {
+    FlushRecord { pc: state.control.pc, before: state.image, pending: state.pending,
+        decisions: action.decisions, sync_ok: action.sync_ok, persisted: action.persisted,
+        result: flushed(state, action) }
+}
+
+pub open spec fn step(state: Product, config: acknowledgement::Config, action: Action) -> Product {
+    if state.control.status != 0 { state }
+    else {
+        let signal = generated_signal(state, action);
+        let control = acknowledgement::step(state.control, config, signal);
+        if is_flush(state) {
+            let result = flushed(state, action);
+            Product { control, image: result.image, pending: result.pending,
+                history: state.history.push(record(state, action)),
+                first_index: if state.control.pc == 24 { state.history.len() as int } else { state.first_index },
+                second_index: if state.control.pc == 28 { state.history.len() as int } else { state.second_index },
+                ..state }
+        } else if !framed(state, action) {
+            Product { control, blocked: true,
+                rejected: Some((action.effect)(state.image, state.pending)), ..state }
+        } else if signal == 0 && (state.control.pc == 23 || state.control.pc == 27) {
+            let bytes = if state.control.pc == 23 { state.first_header } else { state.second_header };
+            Product { control,
+                pending: state.pending.push(seq![storage::Entry { offset: 0, bytes }]), ..state }
+        } else { Product { control, ..state } }
+    }
+}
+
+pub open spec fn run(start: Product, config: acknowledgement::Config, actions: Seq<Action>) -> Product
+    decreases actions.len(),
+{
+    if actions.len() == 0 { start }
+    else { step(run(start, config, actions.drop_last()), config, actions.last()) }
+}
+
+pub open spec fn signals(start: Product, config: acknowledgement::Config, actions: Seq<Action>) -> Seq<int>
+    decreases actions.len(),
+{
+    if actions.len() == 0 { Seq::empty() }
+    else {
+        let prefix = actions.drop_last();
+        signals(start, config, prefix).push(generated_signal(run(start, config, prefix), actions.last()))
+    }
+}
+
+pub open spec fn drained(pending: Seq<Seq<storage::Entry>>) -> bool {
+    forall|stripe: int| 0 <= stripe < pending.len() ==> (#[trigger] pending[stripe]).len() == 0
+}
+
+pub open spec fn exact_record(item: FlushRecord) -> bool {
+    &&& item.pc == 24 || item.pc == 28
+    &&& storage::valid(item.before)
+    &&& storage::pending_valid(item.pending, item.before.visible.len())
+    &&& item.result == storage::model_flush(item.before, item.pending, item.decisions,
+        item.sync_ok, item.persisted)
+    &&& storage::valid(item.result.image)
+    &&& item.result.ok ==> item.result.image.durable == storage::visible_stripes(item.before.visible, item.pending)
+    &&& item.result.ok ==> drained(item.result.pending)
+    &&& item.result.ok ==> item.result.events.len() > 0
+        && item.result.events.last().kind == 3 && item.result.events.last().ok
+    &&& !storage::model_stripes(item.before, item.pending, 0, item.decisions).ok ==>
+        storage::no_sync(item.result.events)
+}
+
+pub open spec fn certificate(state: Product, index: int, pc: int, header: Seq<u8>) -> bool {
+    &&& 0 <= index < state.history.len()
+    &&& state.history[index].pc == pc
+    &&& exact_record(state.history[index])
+    &&& state.history[index].result.ok
+    &&& header_pending(state.history[index].pending, header)
+    &&& state.history[index].result.image.durable.subrange(0, HEADER_BYTES as int) == header
+}
+
+pub open spec fn product_invariant(state: Product, config: acknowledgement::Config) -> bool {
+    &&& storage_valid(state)
+    &&& acknowledgement::cfg_invariant(state.control, config)
+    &&& state.blocked ==> state.control.status == 9
+    &&& state.rejected.is_some() == state.blocked
+    &&& forall|position: int| 0 <= position < state.history.len() ==>
+        exact_record(#[trigger] state.history[position])
+    &&& (state.control.pc == 24 && state.control.status == 0) ==> header_pending(state.pending, state.first_header)
+    &&& (state.control.pc == 28 && state.control.status == 0) ==> header_pending(state.pending, state.second_header)
+    &&& state.control.first_barrier >= 0 ==> certificate(state, state.first_index, 24, state.first_header)
+    &&& state.control.final_barrier >= 0 ==> certificate(state, state.second_index, 28, state.second_header)
+    &&& state.control.final_barrier >= 0 ==> state.first_index < state.second_index
+    &&& state.control.final_barrier >= 0 ==> state.image == state.history[state.second_index].result.image
+        && state.pending == state.history[state.second_index].result.pending
+}
+
+pub proof fn flush_checked(state: Product, action: Action)
+    requires storage_valid(state), is_flush(state),
+    ensures exact_record(record(state, action)),
+        storage::pending_valid(flushed(state, action).pending, state.geometry),
+        flushed(state, action).image.visible.len() == state.geometry,
+{
+    storage::check_stripes(state.image, state.pending, 0, action.decisions);
+    storage::flush_refinement(state.image, state.pending, action.decisions, action.sync_ok, action.persisted);
+    let result = flushed(state, action);
+    let drain = storage::model_stripes(state.image, state.pending, 0, action.decisions);
+    assert forall|stripe: int| 0 <= stripe < result.pending.len() implies
+        storage::entries_valid(#[trigger] result.pending[stripe], state.geometry) by {
+        if stripe < drain.completed {
+            assert(result.pending[stripe] == Seq::<storage::Entry>::empty());
+        } else {
+            assert(result.pending[stripe] == state.pending[stripe]);
+        }
+    }
+}
+
+pub proof fn complete_header(state: Product, action: Action, header: Seq<u8>)
+    requires storage_valid(state), is_flush(state), header.len() == HEADER_BYTES,
+        header_pending(state.pending, header), flushed(state, action).ok,
+    ensures flushed(state, action).image.durable.subrange(0, HEADER_BYTES as int) == header,
+{
+    flush_checked(state, action);
+    storage::check_stripes(state.image, state.pending, 0, action.decisions);
+    let final_bytes = flushed(state, action).image.durable;
+    assert forall|address: int| 0 <= address < HEADER_BYTES implies
+        final_bytes[address] == header[address] by {
+        let selected = (state.pending.len() - 1) as nat;
+        assert(state.pending[selected as int] == seq![storage::Entry { offset: 0, bytes: header }]);
+        storage::stripes_reflect_last_cover(state.image.visible, state.pending, address, selected, 0);
+    }
+    assert(final_bytes.subrange(0, HEADER_BYTES as int) =~= header);
+}
+
+pub proof fn initial_invariant(config: acknowledgement::Config, image: storage::Image,
+    pending: Seq<Seq<storage::Entry>>, first_header: Seq<u8>, second_header: Seq<u8>)
+    requires storage::valid(image), storage::pending_valid(pending, image.visible.len()),
+        HEADER_BYTES <= image.visible.len(), first_header.len() == HEADER_BYTES, second_header.len() == HEADER_BYTES,
+    ensures product_invariant(initial(config, image, pending, first_header, second_header), config),
+{
+    acknowledgement::initial_invariant(config);
+}
+
+pub proof fn step_invariant(state: Product, config: acknowledgement::Config, action: Action)
+    requires acknowledgement::local_mode(config), product_invariant(state, config),
+    ensures product_invariant(step(state, config, action), config),
+{
+    let after = step(state, config, action);
+    let signal = generated_signal(state, action);
+    acknowledgement::step_preserves_invariant(state.control, config, signal);
+    if state.control.status == 0 {
+        if is_flush(state) {
+            flush_checked(state, action);
+            assert forall|position: int| 0 <= position < after.history.len() implies
+                exact_record(#[trigger] after.history[position]) by {
+                if position < state.history.len() {
+                    assert(after.history[position] == state.history[position]);
+                }
+            }
+            if flushed(state, action).ok {
+                if state.control.pc == 24 { complete_header(state, action, state.first_header); }
+                else { complete_header(state, action, state.second_header); }
+            }
+        } else if framed(state, action) && signal == 0
+            && (state.control.pc == 23 || state.control.pc == 27) {
+            assert forall|stripe: int| 0 <= stripe < after.pending.len() implies
+                storage::entries_valid(#[trigger] after.pending[stripe], state.geometry) by {
+                if stripe < state.pending.len() { assert(after.pending[stripe] == state.pending[stripe]); }
+            }
+        }
+    }
+}
+
+pub proof fn checked_run(start: Product, config: acknowledgement::Config, actions: Seq<Action>)
+    requires acknowledgement::local_mode(config), product_invariant(start, config),
+        start.control == acknowledgement::initial(config),
+    ensures product_invariant(run(start, config, actions), config),
+        run(start, config, actions).control == acknowledgement::run(config, signals(start, config, actions)),
+        run(start, config, actions).first_header == start.first_header,
+        run(start, config, actions).second_header == start.second_header,
+        run(start, config, actions).geometry == start.geometry,
+    decreases actions.len(),
+{
+    if actions.len() > 0 {
+        checked_run(start, config, actions.drop_last());
+        let before = run(start, config, actions.drop_last());
+        step_invariant(before, config, actions.last());
+        assert(signals(start, config, actions).drop_last() == signals(start, config, actions.drop_last()));
+        assert(signals(start, config, actions).last() == generated_signal(before, actions.last()));
+    }
+}
+
+pub proof fn public_ok_composes(start: Product, config: acknowledgement::Config, actions: Seq<Action>)
+    requires acknowledgement::local_mode(config), product_invariant(start, config),
+        start.control == acknowledgement::initial(config), run(start, config, actions).control.status == 1,
+    ensures ({
+        let final_state = run(start, config, actions);
+        !final_state.blocked
+            && certificate(final_state, final_state.first_index, 24, final_state.first_header)
+            && certificate(final_state, final_state.second_index, 28, final_state.second_header)
+            && final_state.first_index < final_state.second_index
+            && final_state.image.durable.subrange(0, HEADER_BYTES as int) == final_state.second_header
+            && drained(final_state.pending)
+            && 0 <= final_state.control.first_write < final_state.control.first_barrier
+                < final_state.control.second_write < final_state.control.final_barrier
+                < final_state.control.publication < final_state.control.acknowledgement
+    }),
+{
+    checked_run(start, config, actions);
+    acknowledgement::public_ok_has_two_successful_barriers(config, signals(start, config, actions));
+}
+
+pub open spec fn success_action() -> Action {
+    Action { signal: 0, decisions: storage::successful_decisions(), sync_ok: true,
+        persisted: Set::empty(),
+        effect: |image: storage::Image, pending: Seq<Seq<storage::Entry>>| Effect { image, pending } }
+}
+
+pub proof fn success_signals(start: Product, config: acknowledgement::Config, count: nat)
+    requires acknowledgement::local_mode(config), product_invariant(start, config),
+        start.control == acknowledgement::initial(config),
+    ensures signals(start, config, Seq::new(count, |position: int| success_action()))
+        == Seq::new(count, |position: int| 0int),
+    decreases count,
+{
+    if count > 0 {
+        let actions = Seq::new(count, |position: int| success_action());
+        let prefix = actions.drop_last();
+        assert(prefix =~= Seq::new((count - 1) as nat, |position: int| success_action()));
+        success_signals(start, config, (count - 1) as nat);
+        checked_run(start, config, prefix);
+        let before = run(start, config, prefix);
+        if before.control.status == 0 && is_flush(before) {
+            storage::arbitrary_successful_flush(before.image, before.pending);
+        }
+        assert(generated_signal(before, success_action()) == 0);
+        assert(signals(start, config, actions) =~= Seq::new(count, |position: int| 0int));
+    }
+}
+
+pub proof fn nonvacuous_symbolic_success(image: storage::Image, pending: Seq<Seq<storage::Entry>>,
+    first_header: Seq<u8>, second_header: Seq<u8>)
+    requires storage::valid(image), storage::pending_valid(pending, image.visible.len()),
+        HEADER_BYTES <= image.visible.len(), first_header.len() == HEADER_BYTES, second_header.len() == HEADER_BYTES,
+    ensures ({
+        let config = acknowledgement::witness_config();
+        let start = initial(config, image, pending, first_header, second_header);
+        let actions = Seq::new(46, |position: int| success_action());
+        let result = run(start, config, actions);
+        result.control.status == 1 && !result.blocked
+            && result.image.durable.subrange(0, HEADER_BYTES as int) == second_header
+            && config.old_secondary != config.new_slot
+    }),
+{
+    let config = acknowledgement::witness_config();
+    let start = initial(config, image, pending, first_header, second_header);
+    let actions = Seq::new(46, |position: int| success_action());
+    initial_invariant(config, image, pending, first_header, second_header);
+    success_signals(start, config, 46);
+    checked_run(start, config, actions);
+    acknowledgement::reachable_public_ok_witness();
+    public_ok_composes(start, config, actions);
+}
+
+pub proof fn nonvacuous_post_publication_error(image: storage::Image, pending: Seq<Seq<storage::Entry>>,
+    first_header: Seq<u8>, second_header: Seq<u8>)
+    requires storage::valid(image), storage::pending_valid(pending, image.visible.len()),
+        HEADER_BYTES <= image.visible.len(), first_header.len() == HEADER_BYTES, second_header.len() == HEADER_BYTES,
+    ensures ({
+        let config = acknowledgement::witness_config();
+        let start = initial(config, image, pending, first_header, second_header);
+        let before = run(start, config, Seq::new(34, |position: int| success_action()));
+        let failure = Action { signal: 1, ..success_action() };
+        let after = step(before, config, failure);
+        before.control.pc == 35 && before.control.publication >= 0
+            && after.control.status == 2 && after.control.acknowledgement == -1
+            && after.history == before.history && after.image == before.image
+            && certificate(after, after.second_index, 28, second_header)
+    }),
+{
+    let config = acknowledgement::witness_config();
+    let start = initial(config, image, pending, first_header, second_header);
+    let actions = Seq::new(34, |position: int| success_action());
+    initial_invariant(config, image, pending, first_header, second_header);
+    success_signals(start, config, 34);
+    checked_run(start, config, actions);
+    acknowledgement::successful_prefix_reaches_pc(34);
+    acknowledgement::run_invariant(config, Seq::new(34, |position: int| 0int));
+    let before = run(start, config, actions);
+    let failure = Action { signal: 1, ..success_action() };
+    acknowledgement::later_error_does_not_erase_publication(before.control, config);
+    step_invariant(before, config, failure);
+}
+
+pub proof fn callback_mismatch_stops_open(state: Product, config: acknowledgement::Config, action: Action)
+    requires state.control.status == 0, !is_flush(state), !framed(state, action),
+    ensures step(state, config, action).control.status == 9,
+        step(state, config, action).blocked,
+        step(state, config, action).rejected == Some((action.effect)(state.image, state.pending)),
+        step(state, config, action).history == state.history,
+{}
+
+pub proof fn error_keeps_actual_complete_flush(state: Product, config: acknowledgement::Config, action: Action)
+    requires acknowledgement::local_mode(config), state.control.status == 0, is_flush(state), !flushed(state, action).ok,
+    ensures step(state, config, action).control.status == 2,
+        step(state, config, action).image == flushed(state, action).image,
+        step(state, config, action).pending == flushed(state, action).pending,
+        step(state, config, action).history == state.history.push(record(state, action)),
+        step(state, config, action).history.last() == record(state, action),
+{}
+
+}
diff --git a/evidence/redb-storage-composition110/laneA/buffered_flush109.rs b/evidence/redb-storage-composition110/laneA/buffered_flush109.rs
new file mode 100644
--- /dev/null
+++ b/evidence/redb-storage-composition110/laneA/buffered_flush109.rs
@@ -0,0 +1,764 @@
+use vstd::prelude::*;
+
+verus! {
+
+pub struct Image {
+    pub visible: Seq<u8>,
+    pub durable: Seq<u8>,
+    pub permitted: Map<int, Set<u8>>,
+}
+
+pub struct Entry {
+    pub offset: nat,
+    pub bytes: Seq<u8>,
+}
+
+pub struct Decision {
+    pub ok: bool,
+    pub changed: Set<int>,
+    pub persisted: Set<int>,
+}
+
+pub struct Event {
+    pub kind: nat,
+    pub stripe: nat,
+    pub index: nat,
+    pub ok: bool,
+}
+
+pub struct Chunk {
+    pub image: Image,
+    pub events: Seq<Event>,
+    pub ok: bool,
+    pub successful: nat,
+}
+
+pub struct Run {
+    pub image: Image,
+    pub pending: Seq<Seq<Entry>>,
+    pub events: Seq<Event>,
+    pub ok: bool,
+    pub completed: nat,
+}
+
+pub struct Buffered {
+    pub backend: Image,
+    pub slots: Map<nat, Seq<u8>>,
+}
+
+pub open spec fn buffer_application(before: Buffered, offset: nat, bytes: Seq<u8>) -> Buffered {
+    Buffered { backend: before.backend, slots: before.slots.insert(offset, bytes) }
+}
+
+pub open spec fn buffer_repeated(before: Buffered, offset: nat, values: Seq<Seq<u8>>) -> Buffered
+    decreases values.len(),
+{
+    if values.len() == 0 { before } else {
+        buffer_repeated(buffer_application(before, offset, values[0]), offset,
+            values.subrange(1, values.len() as int))
+    }
+}
+
+pub open spec fn valid(image: Image) -> bool {
+    &&& image.visible.len() == image.durable.len()
+    &&& forall|address: int| #[trigger] image.permitted.dom().contains(address)
+        <==> 0 <= address < image.visible.len()
+    &&& forall|address: int| 0 <= address < image.visible.len() ==>
+        #[trigger] image.permitted[address].contains(image.visible[address])
+        && image.permitted[address].contains(image.durable[address])
+}
+
+pub open spec fn entry_valid(entry: Entry, length: nat) -> bool {
+    entry.offset + entry.bytes.len() <= length
+}
+
+pub open spec fn entries_valid(entries: Seq<Entry>, length: nat) -> bool {
+    forall|position: int| 0 <= position < entries.len() ==>
+        entry_valid(#[trigger] entries[position], length)
+}
+
+pub open spec fn pending_valid(pending: Seq<Seq<Entry>>, length: nat) -> bool {
+    forall|stripe: int| 0 <= stripe < pending.len() ==>
+        entries_valid(#[trigger] pending[stripe], length)
+}
+
+pub open spec fn clean(bytes: Seq<u8>) -> Image {
+    Image { visible: bytes, durable: bytes,
+        permitted: Map::new(Set::range(0, bytes.len() as int),
+            |address: int| Set::empty().insert(bytes[address])) }
+}
+
+pub open spec fn overwrite(visible: Seq<u8>, entry: Entry) -> Seq<u8> {
+    Seq::new(visible.len(), |address: int|
+        if entry.offset <= address < entry.offset + entry.bytes.len() {
+            entry.bytes[address - entry.offset]
+        } else { visible[address] })
+}
+
+pub open spec fn write_visible(before: Image, entry: Entry, decision: Decision) -> Seq<u8> {
+    Seq::new(before.visible.len(), |address: int|
+        if entry.offset <= address < entry.offset + entry.bytes.len()
+            && (decision.ok || decision.changed.contains(address)) {
+            entry.bytes[address - entry.offset]
+        } else { before.visible[address] })
+}
+
+pub open spec fn backend_write(before: Image, entry: Entry, decision: Decision) -> Image {
+    let visible = write_visible(before, entry, decision);
+    Image {
+        visible,
+        durable: Seq::new(before.durable.len(), |address: int|
+            if decision.persisted.contains(address) { visible[address] }
+            else { before.durable[address] }),
+        permitted: Map::new(before.permitted.dom(), |address: int|
+            before.permitted[address].insert(visible[address])),
+    }
+}
+
+pub open spec fn backend_sync(before: Image, ok: bool, persisted: Set<int>) -> Image {
+    if ok { clean(before.visible) } else {
+        Image { visible: before.visible,
+            durable: Seq::new(before.durable.len(), |address: int|
+                if persisted.contains(address) { before.visible[address] }
+                else { before.durable[address] }),
+            permitted: before.permitted }
+    }
+}
+
+pub open spec fn event(kind: nat, stripe: nat, index: nat, ok: bool) -> Event {
+    Event { kind, stripe, index, ok }
+}
+
+pub open spec fn no_sync(events: Seq<Event>) -> bool {
+    forall|position: int| 0 <= position < events.len() ==>
+        (#[trigger] events[position]).kind != 3
+}
+
+pub open spec fn model_entries(before: Image, entries: Seq<Entry>, stripe: nat,
+    index: nat, decisions: spec_fn(nat, nat) -> Decision) -> Chunk
+    decreases entries.len(),
+{
+    if entries.len() == 0 {
+        Chunk { image: before, events: Seq::empty(), ok: true, successful: 0 }
+    } else {
+        let decision = decisions(stripe, index);
+        let written = backend_write(before, entries[0], decision);
+        let attempt = event(0, stripe, index, decision.ok);
+        if !decision.ok {
+            Chunk { image: written, events: seq![attempt], ok: false, successful: 0 }
+        } else {
+            let tail = model_entries(written, entries.subrange(1, entries.len() as int),
+                stripe, index + 1, decisions);
+            Chunk { image: tail.image, events: seq![attempt] + tail.events,
+                ok: tail.ok, successful: tail.successful + 1 }
+        }
+    }
+}
+
+pub open spec fn visible_entries(before: Seq<u8>, entries: Seq<Entry>) -> Seq<u8>
+    decreases entries.len(),
+{
+    if entries.len() == 0 { before } else {
+        visible_entries(overwrite(before, entries[0]), entries.subrange(1, entries.len() as int))
+    }
+}
+
+pub open spec fn model_stripes(before: Image, pending: Seq<Seq<Entry>>, stripe: nat,
+    decisions: spec_fn(nat, nat) -> Decision) -> Run
+    decreases pending.len(),
+{
+    if pending.len() == 0 {
+        Run { image: before, pending: Seq::empty(), events: seq![event(2, stripe, 0, true)],
+            ok: true, completed: 0 }
+    } else {
+        let head = model_entries(before, pending[0], stripe, 0, decisions);
+        if !head.ok {
+            Run { image: head.image, pending, events: head.events, ok: false, completed: 0 }
+        } else {
+            let tail = model_stripes(head.image, pending.subrange(1, pending.len() as int),
+                stripe + 1, decisions);
+            Run { image: tail.image, pending: seq![Seq::empty()] + tail.pending,
+                events: head.events + seq![event(1, stripe, 0, true)] + tail.events,
+                ok: tail.ok, completed: tail.completed + 1 }
+        }
+    }
+}
+
+pub open spec fn visible_stripes(before: Seq<u8>, pending: Seq<Seq<Entry>>) -> Seq<u8>
+    decreases pending.len(),
+{
+    if pending.len() == 0 { before } else {
+        visible_stripes(visible_entries(before, pending[0]), pending.subrange(1, pending.len() as int))
+    }
+}
+
+pub open spec fn model_flush(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>) -> Run {
+    let drained = model_stripes(before, pending, 0, decisions);
+    if !drained.ok { drained } else {
+        Run { image: backend_sync(drained.image, sync_ok, persisted), pending: drained.pending,
+            events: drained.events + seq![event(3, 0, 0, sync_ok)], ok: sync_ok,
+            completed: drained.completed }
+    }
+}
+
+pub proof fn clean_valid(bytes: Seq<u8>)
+    ensures valid(clean(bytes)),
+{
+    vstd::set_lib::lemma_int_range(0, bytes.len() as int);
+}
+
+pub proof fn write_valid(before: Image, entry: Entry, decision: Decision)
+    requires valid(before), entry_valid(entry, before.visible.len()),
+    ensures valid(backend_write(before, entry, decision)),
+        backend_write(before, entry, decision).visible.len() == before.visible.len(),
+        decision.ok ==> backend_write(before, entry, decision).visible == overwrite(before.visible, entry),
+        forall|address: int| 0 <= address < before.visible.len()
+            && !(entry.offset <= address < entry.offset + entry.bytes.len()) ==>
+            backend_write(before, entry, decision).visible[address] == before.visible[address],
+{
+    let after = backend_write(before, entry, decision);
+    assert forall|address: int| 0 <= address < after.visible.len() implies
+        #[trigger] after.permitted[address].contains(after.visible[address])
+        && after.permitted[address].contains(after.durable[address]) by {
+        assert(before.permitted[address].contains(before.visible[address]));
+        assert(before.permitted[address].contains(before.durable[address]));
+    }
+    if decision.ok {
+        assert(after.visible =~= overwrite(before.visible, entry));
+    }
+}
+
+pub proof fn sync_valid(before: Image, ok: bool, persisted: Set<int>)
+    requires valid(before),
+    ensures valid(backend_sync(before, ok, persisted)),
+        backend_sync(before, ok, persisted).visible == before.visible,
+        ok ==> backend_sync(before, ok, persisted).durable == before.visible,
+{
+    if ok { clean_valid(before.visible); } else {
+        let after = backend_sync(before, ok, persisted);
+        assert forall|address: int| 0 <= address < after.visible.len() implies
+            #[trigger] after.permitted[address].contains(after.visible[address])
+            && after.permitted[address].contains(after.durable[address]) by {
+            assert(before.permitted[address].contains(before.visible[address]));
+            assert(before.permitted[address].contains(before.durable[address]));
+        }
+    }
+}
+
+pub proof fn concat_no_sync(left: Seq<Event>, right: Seq<Event>)
+    requires no_sync(left), no_sync(right),
+    ensures no_sync(left + right),
+{
+    assert forall|position: int| 0 <= position < (left + right).len() implies
+        (#[trigger] (left + right)[position]).kind != 3 by {
+        if position < left.len() { assert(left[position].kind != 3); }
+        else { assert(right[position - left.len()].kind != 3); }
+    }
+}
+
+pub proof fn check_entries(before: Image, entries: Seq<Entry>, stripe: nat,
+    index: nat, decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), entries_valid(entries, before.visible.len()),
+    ensures valid(model_entries(before, entries, stripe, index, decisions).image),
+        model_entries(before, entries, stripe, index, decisions).image.visible.len() == before.visible.len(),
+        no_sync(model_entries(before, entries, stripe, index, decisions).events),
+        model_entries(before, entries, stripe, index, decisions).successful <= entries.len(),
+        model_entries(before, entries, stripe, index, decisions).ok ==>
+            model_entries(before, entries, stripe, index, decisions).successful == entries.len(),
+        !model_entries(before, entries, stripe, index, decisions).ok ==>
+            model_entries(before, entries, stripe, index, decisions).successful < entries.len(),
+        model_entries(before, entries, stripe, index, decisions).ok ==>
+            model_entries(before, entries, stripe, index, decisions).image.visible
+                == visible_entries(before.visible, entries),
+        model_entries(before, entries, stripe, index, decisions).events.len()
+            == model_entries(before, entries, stripe, index, decisions).successful
+                + if model_entries(before, entries, stripe, index, decisions).ok { 0nat } else { 1nat },
+        forall|position: int| 0 <= position < model_entries(before, entries, stripe, index, decisions).events.len() ==>
+            (#[trigger] model_entries(before, entries, stripe, index, decisions).events[position])
+                == event(0, stripe, index + position as nat,
+                    position < model_entries(before, entries, stripe, index, decisions).successful),
+    decreases entries.len(),
+{
+    if entries.len() > 0 {
+        let decision = decisions(stripe, index);
+        let written = backend_write(before, entries[0], decision);
+        write_valid(before, entries[0], decision);
+        if decision.ok {
+            let rest = entries.subrange(1, entries.len() as int);
+            assert(entries_valid(rest, written.visible.len())) by {
+                assert forall|position: int| 0 <= position < rest.len() implies
+                    entry_valid(#[trigger] rest[position], written.visible.len()) by {
+                    assert(rest[position] == entries[position + 1]);
+                }
+            }
+            check_entries(written, rest, stripe, index + 1, decisions);
+            concat_no_sync(seq![event(0, stripe, index, true)],
+                model_entries(written, rest, stripe, index + 1, decisions).events);
+            let result = model_entries(before, entries, stripe, index, decisions);
+            let tail = model_entries(written, rest, stripe, index + 1, decisions);
+            assert forall|position: int| 0 <= position < result.events.len() implies
+                (#[trigger] result.events[position]) == event(0, stripe, index + position as nat,
+                    position < result.successful) by {
+                if position > 0 {
+                    assert(result.events[position] == tail.events[position - 1]);
+                    assert(tail.events[position - 1] == event(0, stripe,
+                        index + 1 + (position - 1) as nat, position - 1 < tail.successful));
+                }
+            }
+        }
+    }
+}
+
+pub proof fn check_stripes(before: Image, pending: Seq<Seq<Entry>>, stripe: nat,
+    decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+    ensures valid(model_stripes(before, pending, stripe, decisions).image),
+        model_stripes(before, pending, stripe, decisions).image.visible.len() == before.visible.len(),
+        no_sync(model_stripes(before, pending, stripe, decisions).events),
+        model_stripes(before, pending, stripe, decisions).pending.len() == pending.len(),
+        model_stripes(before, pending, stripe, decisions).completed <= pending.len(),
+        model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).completed == pending.len(),
+        !model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).completed < pending.len(),
+        forall|position: int| 0 <= position < pending.len() ==>
+            (#[trigger] model_stripes(before, pending, stripe, decisions).pending[position])
+                == if position < model_stripes(before, pending, stripe, decisions).completed {
+                    Seq::<Entry>::empty() } else { pending[position] },
+        model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).image.visible
+                == visible_stripes(before.visible, pending),
+        model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).events.last().kind == 2,
+        !model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).events.len() > 0
+            && model_stripes(before, pending, stripe, decisions).events.last().kind == 0
+            && !model_stripes(before, pending, stripe, decisions).events.last().ok,
+        forall|position: int| 0 <= position < model_stripes(before, pending, stripe, decisions).events.len()
+            && (#[trigger] model_stripes(before, pending, stripe, decisions).events[position]).kind == 1 ==>
+                stripe <= model_stripes(before, pending, stripe, decisions).events[position].stripe
+                    < stripe + model_stripes(before, pending, stripe, decisions).completed,
+    decreases pending.len(),
+{
+    if pending.len() > 0 {
+        check_entries(before, pending[0], stripe, 0, decisions);
+        let head = model_entries(before, pending[0], stripe, 0, decisions);
+        if head.ok {
+            let rest = pending.subrange(1, pending.len() as int);
+            assert(pending_valid(rest, head.image.visible.len())) by {
+                assert forall|position: int| 0 <= position < rest.len() implies
+                    entries_valid(#[trigger] rest[position], head.image.visible.len()) by {
+                    assert(rest[position] == pending[position + 1]);
+                }
+            }
+            check_stripes(head.image, rest, stripe + 1, decisions);
+            let tail = model_stripes(head.image, rest, stripe + 1, decisions);
+            concat_no_sync(head.events, seq![event(1, stripe, 0, true)]);
+            concat_no_sync(head.events + seq![event(1, stripe, 0, true)], tail.events);
+            let result = model_stripes(before, pending, stripe, decisions);
+            assert forall|position: int| 0 <= position < pending.len() implies
+                (#[trigger] result.pending[position])
+                    == if position < result.completed { Seq::<Entry>::empty() } else { pending[position] } by {
+                if position > 0 {
+                    assert(result.pending[position] == tail.pending[position - 1]);
+                    assert(tail.pending[position - 1] == if position - 1 < tail.completed {
+                        Seq::<Entry>::empty() } else { rest[position - 1] });
+                }
+            }
+            assert forall|position: int| 0 <= position < result.events.len()
+                && (#[trigger] result.events[position]).kind == 1 implies
+                    stripe <= result.events[position].stripe < stripe + result.completed by {
+                if position < head.events.len() {
+                    assert(head.events[position].kind == 0);
+                } else if position > head.events.len() {
+                    let tail_position = position - head.events.len() - 1;
+                    assert(result.events[position] == tail.events[tail_position]);
+                    assert(stripe + 1 <= tail.events[tail_position].stripe
+                        < stripe + 1 + tail.completed);
+                }
+            }
+        }
+    }
+}
+
+pub proof fn flush_refinement(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+    ensures valid(model_flush(before, pending, decisions, sync_ok, persisted).image),
+        model_flush(before, pending, decisions, sync_ok, persisted).ok ==>
+            model_flush(before, pending, decisions, sync_ok, persisted).image.durable
+                == visible_stripes(before.visible, pending),
+        model_stripes(before, pending, 0, decisions).ok ==>
+            forall|position: int| 0 <= position < pending.len() ==>
+                (#[trigger] model_flush(before, pending, decisions, sync_ok, persisted).pending[position]).len() == 0,
+        !model_stripes(before, pending, 0, decisions).ok ==>
+            no_sync(model_flush(before, pending, decisions, sync_ok, persisted).events),
+        model_stripes(before, pending, 0, decisions).ok ==>
+            model_flush(before, pending, decisions, sync_ok, persisted).events.last().kind == 3,
+{
+    check_stripes(before, pending, 0, decisions);
+    let drained = model_stripes(before, pending, 0, decisions);
+    if drained.ok {
+        sync_valid(drained.image, sync_ok, persisted);
+        assert forall|position: int| 0 <= position < pending.len() implies
+            (#[trigger] model_flush(before, pending, decisions, sync_ok, persisted).pending[position]).len() == 0 by {
+            assert(drained.pending[position] == Seq::<Entry>::empty());
+        }
+    }
+}
+
+pub proof fn same_offset_coalesces(pending: Map<nat, Seq<u8>>, offset: nat,
+    earlier: Seq<u8>, latest: Seq<u8>)
+    ensures pending.insert(offset, earlier).insert(offset, latest) == pending.insert(offset, latest),
+        pending.insert(offset, earlier).insert(offset, latest)[offset] == latest,
+{
+    assert(pending.insert(offset, earlier).insert(offset, latest) =~= pending.insert(offset, latest));
+}
