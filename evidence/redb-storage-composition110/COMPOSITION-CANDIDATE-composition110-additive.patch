+pub proof fn localized_partial_error_control()
+{
+    let before = clean(seq![0u8, 0u8]);
+    let entry = Entry { offset: 0, bytes: seq![7u8, 9u8] };
+    let decision = Decision { ok: false, changed: Set::empty().insert(0),
+        persisted: Set::empty().insert(0) };
+    let after = backend_write(before, entry, decision);
+    assert(after.visible[0] == 7);
+    assert(after.visible[1] == 0);
+    assert(after.durable[0] == 7);
+    assert(after.durable[1] == 0);
+    assert(after.visible != before.visible);
+    assert(after.durable != before.durable);
+}
+
+pub proof fn successful_prefix_retained(before: Image, entries: Seq<Entry>, stripe: nat,
+    index: nat, prefix: nat, decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), entries_valid(entries, before.visible.len()), prefix < entries.len(),
+        forall|position: nat| position < prefix ==> (#[trigger] decisions(stripe, index + position)).ok,
+        !decisions(stripe, index + prefix).ok,
+    ensures !model_entries(before, entries, stripe, index, decisions).ok,
+        model_entries(before, entries, stripe, index, decisions).successful == prefix,
+        model_entries(before, entries, stripe, index, decisions).events.len() == prefix + 1,
+        model_stripes(before, seq![entries], stripe,
+            |selected_stripe: nat, position: nat| decisions(selected_stripe, index + position)).pending == seq![entries],
+    decreases prefix,
+{
+    check_entries(before, entries, stripe, index, decisions);
+    if prefix > 0 {
+        let decision = decisions(stripe, index);
+        assert(decisions(stripe, index + 0).ok);
+        assert(decision.ok);
+        write_valid(before, entries[0], decision);
+        let written = backend_write(before, entries[0], decision);
+        let rest = entries.subrange(1, entries.len() as int);
+        assert(entries_valid(rest, written.visible.len())) by {
+            assert forall|position: int| 0 <= position < rest.len() implies
+                entry_valid(#[trigger] rest[position], written.visible.len()) by {
+                assert(rest[position] == entries[position + 1]);
+            }
+        }
+        assert forall|position: nat| position < prefix - 1 implies
+            (#[trigger] decisions(stripe, index + 1 + position)).ok by {
+            assert(decisions(stripe, index + (position + 1)).ok);
+        }
+        successful_prefix_retained(written, rest, stripe, index + 1, (prefix - 1) as nat, decisions);
+    }
+    shifted_decisions(before, entries, stripe, 0, index, decisions);
+}
+
+pub proof fn shifted_decisions(before: Image, entries: Seq<Entry>, stripe: nat,
+    index: nat, shift: nat, decisions: spec_fn(nat, nat) -> Decision)
+    ensures model_entries(before, entries, stripe, index + shift, decisions).image
+        == model_entries(before, entries, stripe, index,
+            |selected_stripe: nat, position: nat| decisions(selected_stripe, shift + position)).image,
+        model_entries(before, entries, stripe, index + shift, decisions).ok
+        == model_entries(before, entries, stripe, index,
+            |selected_stripe: nat, position: nat| decisions(selected_stripe, shift + position)).ok,
+    decreases entries.len(),
+{
+    if entries.len() > 0 && decisions(stripe, index + shift).ok {
+        shifted_decisions(backend_write(before, entries[0], decisions(stripe, index + shift)),
+            entries.subrange(1, entries.len() as int), stripe, index + 1, shift, decisions);
+    }
+}
+
+pub open spec fn covers(entry: Entry, address: int) -> bool {
+    entry.offset <= address < entry.offset + entry.bytes.len()
+}
+
+pub proof fn entries_preserve_address(before: Seq<u8>, entries: Seq<Entry>, address: int)
+    requires 0 <= address < before.len(),
+        forall|position: int| 0 <= position < entries.len() ==> !covers(#[trigger] entries[position], address),
+    ensures visible_entries(before, entries)[address] == before[address],
+        visible_entries(before, entries).len() == before.len(),
+    decreases entries.len(),
+{
+    if entries.len() > 0 {
+        let rest = entries.subrange(1, entries.len() as int);
+        assert forall|position: int| 0 <= position < rest.len() implies
+            !covers(#[trigger] rest[position], address) by {
+            assert(rest[position] == entries[position + 1]);
+        }
+        entries_preserve_address(overwrite(before, entries[0]), rest, address);
+    }
+}
+
+pub proof fn entries_reflect_last_cover(before: Seq<u8>, entries: Seq<Entry>, address: int, selected: nat)
+    requires 0 <= address < before.len(), selected < entries.len(), covers(entries[selected as int], address),
+        forall|position: int| selected < position < entries.len() ==>
+            !covers(#[trigger] entries[position], address),
+    ensures visible_entries(before, entries)[address]
+        == entries[selected as int].bytes[address - entries[selected as int].offset],
+        visible_entries(before, entries).len() == before.len(),
+    decreases selected,
+{
+    let rest = entries.subrange(1, entries.len() as int);
+    if selected == 0 {
+        assert forall|position: int| 0 <= position < rest.len() implies
+            !covers(#[trigger] rest[position], address) by {
+            assert(rest[position] == entries[position + 1]);
+        }
+        entries_preserve_address(overwrite(before, entries[0]), rest, address);
+    } else {
+        assert(rest[(selected - 1) as int] == entries[selected as int]);
+        assert forall|position: int| selected - 1 < position < rest.len() implies
+            !covers(#[trigger] rest[position], address) by {
+            assert(rest[position] == entries[position + 1]);
+        }
+        entries_reflect_last_cover(overwrite(before, entries[0]), rest, address, (selected - 1) as nat);
+    }
+}
+
+pub proof fn stripe_drains_only_after_writes(before: Image, entries: Seq<Entry>, stripe: nat,
+    decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), entries_valid(entries, before.visible.len()),
+        model_entries(before, entries, stripe, 0, decisions).ok,
+    ensures model_stripes(before, seq![entries], stripe, decisions).events.len() == entries.len() + 2,
+        model_stripes(before, seq![entries], stripe, decisions).events[entries.len() as int].kind == 1,
+        model_stripes(before, seq![entries], stripe, decisions).events.last().kind == 2,
+        forall|position: int| 0 <= position < entries.len() ==>
+            (#[trigger] model_stripes(before, seq![entries], stripe, decisions).events[position])
+                == event(0, stripe, position as nat, true),
+{
+    reveal_with_fuel(model_stripes, 2);
+    check_entries(before, entries, stripe, 0, decisions);
+    assert(seq![entries].subrange(1, 1) =~= Seq::<Seq<Entry>>::empty());
+}
