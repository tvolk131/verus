+
+pub fn validates_constructed_positive_goal<H: Hasher, D: Data>(
+    parent_hash: H::Hash, data: Option<D>, session: SessionId,
+) -> (result: Result<H, D, ValidationExampleKeychain>)
+    ensures match result {
+        Ok(signed) => signed@.1 == 37 && signed@.0@.2 == session &&
+            signed@.0@.1 == data && signed@.0@.0@.0 == 1 && signed@.0@.0@.1 == NodeIndex(0),
+        _ => false,
+    },
+{
+    let mut parents = crate::NodeMap::with_size(NodeCount(1));
+    parents.insert(NodeIndex(0), (parent_hash, 0));
+    let control = crate::units::ControlHash::<H>::new(&parents);
+    control.validate_eligible(UnitCoord::new(1, NodeIndex(0)));
+    let pre = PreUnit::new(NodeIndex(0), 1, control);
+    let unit = FullUnit::new(pre, data, session);
+    let input = validation_example_input(unit, 37);
+    Validator::new(session, ValidationExampleKeychain { count: NodeCount(1) }, 1).validate_unit(input)
+}
