+use aleph_bft_types::{ValidationExampleKeychain, validation_example_input};
+
+fn validation_order_goal<H: Hasher, D: Data>(
+    input: UncheckedSignedUnit<H, D, u8>, count: NodeCount,
+    session: SessionId, max_round: Round,
+) -> (result: Result<H, D, ValidationExampleKeychain>)
+    requires input@.0@.0@.0 > 0 ==> count.0 <= usize::MAX / 2,
+    ensures
+        if input@.1 != 37 || input@.0@.0@.1.0 >= count.0 {
+            match result {
+                Err(ValidationError::WrongSignature(payload)) => payload@ == input@,
+                _ => false,
+            }
+        } else if input@.0@.2 != session {
+            match result {
+                Err(ValidationError::WrongSession(payload)) => input@.0.clone_relation(payload),
+                _ => false,
+            }
+        } else if input@.0@.0@.0 > max_round {
+            match result {
+                Err(ValidationError::RoundTooHigh(payload)) => input@.0.clone_relation(payload),
+                _ => false,
+            }
+        } else if input@.0@.0@.2@.0.len() != count.0 {
+            match result {
+                Err(ValidationError::WrongNumberOfMembers(payload)) =>
+                    input@.0@.0.__verus_clone_relation(payload),
+                _ => false,
+            }
+        } else {
+            let validator = Validator { session_id: session,
+                keychain: ValidationExampleKeychain { count }, max_round };
+            match result {
+                Ok(signed) => signed@ == input@ && validator.metadata_policy(input@.0, Ok(())),
+                Err(ValidationError::ParentValidationFailed(payload, error)) =>
+                    input@.0@.0.__verus_clone_relation(payload) && validator.metadata_policy(input@.0, Err(error)),
+                _ => false,
+            }
+        },
+{
