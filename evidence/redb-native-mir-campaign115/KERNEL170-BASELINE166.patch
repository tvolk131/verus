+#[cfg(feature = "native-semantics170-inspect")]
+pub fn inspect_native170_to_air(
+    ctx: &Ctx,
+    kernel: &mut crate::native_resource::kernel170::Kernel170,
+    canonical: &crate::native_resource::kernel170::Canonical170,
+    call: &crate::native_resource::kernel170::Call170,
+    instruction: &Stm,
+) -> Result<(crate::native_resource::kernel170::Transition170, Vec<Stmt>), VirErr> {
+    let mut transition = kernel.allocate(canonical, call, instruction)
+        .map_err(|refusal| error(&instruction.span, format!("native170: {refusal:?}")))?;
+    let StmX::Call { args, dest: Some(destination), .. } = &transition.canonical_call.x else {
+        return Err(error(&instruction.span, "native170 internal canonical call mismatch"));
+    };
+    if !ctx.func_map.contains_key(&canonical.allocate.x.name) {
+        return Err(error(&instruction.span, "native170 canonical function not loaded"));
+    }
+    let mut statements = Vec::new();
+    if let Some(condition) = &transition.incoming_empty_obligation {
+        statements.push(Arc::new(StmtX::Assert(None,
+            error(&instruction.span, "native170 complete incoming native frontier must be empty"),
+            None, exp_to_expr(ctx, condition, &ExprCtxt::new())?)));
+    }
+    let argument_expressions = args.iter().map(|argument| exp_to_expr(ctx, argument, &ExprCtxt::new()))
+        .collect::<Result<Vec<_>, _>>()?;
+    let function = fun_to_air_ident(&ctx.name_ctxt, &canonical.allocate.x.name);
+    statements.push(Arc::new(StmtX::Assert(None,
+        error(&instruction.span, "native170 actual positive size and valid numeric alignment"), None,
+        Arc::new(ExprX::Apply(prefix_requires(&function), Arc::new(argument_expressions.clone()))))));
+    let destination_name = suffix_local_unique_id(&get_loc_var(&destination.dest));
+    transition.air_local_decls.push(Arc::new(DeclX::Var(destination_name.clone(),typ_to_air(ctx,&destination.dest.typ))));
+    statements.push(Arc::new(StmtX::Havoc(destination_name.clone())));
+    if let Some(invariant) = typ_invariant(ctx, &destination.dest.typ, &ident_var(&destination_name)) {
+        statements.push(Arc::new(StmtX::Assume(invariant)));
+    }
+    let address = SpannedTyped::new(&instruction.span, &Arc::new(TypX::Int(IntRange::USize)),
+        ExpX::Call(CallFun::Fun(canonical.address.x.name.clone(),None),
+            Arc::new(vec![Arc::new(TypX::Int(IntRange::U(8)))]),Arc::new(vec![transition.native_return.clone()])));
+    let address = exp_to_expr(ctx,&address,&ExprCtxt::new())?;
+    statements.push(Arc::new(StmtX::Assert(None,
+        error(&instruction.span,"native170 SAME actual native normal-return full pointer must be nonnull"),
+        None,mk_not(&mk_eq(&address,&mk_nat(0))))));
+    let mut ensures_arguments = argument_expressions;
+    ensures_arguments.push(ident_var(&destination_name));
+    statements.push(Arc::new(StmtX::Assume(Arc::new(ExprX::Apply(
+        prefix_ensures(&function), Arc::new(ensures_arguments))))));
+    Ok((transition, statements))
+}
