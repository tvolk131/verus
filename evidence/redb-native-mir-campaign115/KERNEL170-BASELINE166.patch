+#[cfg(feature = "native-semantics170-inspect")]
+pub(crate) fn load_native170_inspection(path: &Path) -> Result<Krate, String> {
+    if path.extension().is_some_and(|extension| extension == "json") {
+        let input = std::io::BufReader::new(std::fs::File::open(path).map_err(|error| error.to_string())?);
+        let krate: Krate = serde_json::from_reader(input).map_err(|error| error.to_string())?;
+        vir::native_resource::reject_crate(&krate, "native170 genuine retained canonical AST compatibility inspection")
+            .map_err(|error| error.note.clone())?;
+        return Ok(krate);
+    }
+    let mut input = std::io::BufReader::new(std::fs::File::open(path).map_err(|error| error.to_string())?);
+    let value: CrateWithMetadata = bincode_next::serde::decode_from_std_read(
+        &mut input, bincode_next::config::legacy()).map_err(|error| error.to_string())?;
+    vir::native_resource::reject_crate(&value.krate, "native170 canonical inspection")
+        .map_err(|error| error.note.clone())?;
+    Ok(value.krate)
+}
