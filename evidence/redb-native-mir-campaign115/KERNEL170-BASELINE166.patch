+pub(crate) fn native170_branch_air(ctx: &Ctx, condition: &Exp, mut positive: Vec<Stmt>, mut negative: Vec<Stmt>) -> Result<Stmt, VirErr> {
+    let condition = exp_to_expr(ctx, condition, &ExprCtxt::new())?;
+    positive.insert(0, Arc::new(StmtX::Assume(condition.clone())));
+    negative.insert(0, Arc::new(StmtX::Assume(mk_not(&condition))));
+    Ok(Arc::new(StmtX::Switch(Arc::new(vec![one_stmt(positive), one_stmt(negative)]))))
