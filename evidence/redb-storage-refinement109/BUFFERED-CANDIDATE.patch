+pub proof fn same_offset_coalesces(pending: Map<nat, Seq<u8>>, offset: nat,
+    earlier: Seq<u8>, latest: Seq<u8>)
+    ensures pending.insert(offset, earlier).insert(offset, latest) == pending.insert(offset, latest),
+        pending.insert(offset, earlier).insert(offset, latest)[offset] == latest,
+{
+    assert(pending.insert(offset, earlier).insert(offset, latest) =~= pending.insert(offset, latest));
+}
