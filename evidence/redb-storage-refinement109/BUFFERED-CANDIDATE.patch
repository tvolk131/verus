+pub open spec fn covers(entry: Entry, address: int) -> bool {
+    entry.offset <= address < entry.offset + entry.bytes.len()
+}
+
+pub proof fn entries_preserve_address(before: Seq<u8>, entries: Seq<Entry>, address: int)
+    requires 0 <= address < before.len(),
+        forall|position: int| 0 <= position < entries.len() ==> !covers(#[trigger] entries[position], address),
+    ensures visible_entries(before, entries)[address] == before[address],
+        visible_entries(before, entries).len() == before.len(),
+    decreases entries.len(),
+{
+    if entries.len() > 0 {
+        let rest = entries.subrange(1, entries.len() as int);
+        assert forall|position: int| 0 <= position < rest.len() implies
+            !covers(#[trigger] rest[position], address) by {
+            assert(rest[position] == entries[position + 1]);
+        }
+        entries_preserve_address(overwrite(before, entries[0]), rest, address);
+    }
+}
+
+pub proof fn entries_reflect_last_cover(before: Seq<u8>, entries: Seq<Entry>, address: int, selected: nat)
+    requires 0 <= address < before.len(), selected < entries.len(), covers(entries[selected as int], address),
+        forall|position: int| selected < position < entries.len() ==>
+            !covers(#[trigger] entries[position], address),
+    ensures visible_entries(before, entries)[address]
+        == entries[selected as int].bytes[address - entries[selected as int].offset],
+        visible_entries(before, entries).len() == before.len(),
+    decreases selected,
+{
+    let rest = entries.subrange(1, entries.len() as int);
+    if selected == 0 {
+        assert forall|position: int| 0 <= position < rest.len() implies
+            !covers(#[trigger] rest[position], address) by {
+            assert(rest[position] == entries[position + 1]);
+        }
+        entries_preserve_address(overwrite(before, entries[0]), rest, address);
+    } else {
+        assert(rest[(selected - 1) as int] == entries[selected as int]);
+        assert forall|position: int| selected - 1 < position < rest.len() implies
+            !covers(#[trigger] rest[position], address) by {
+            assert(rest[position] == entries[position + 1]);
+        }
+        entries_reflect_last_cover(overwrite(before, entries[0]), rest, address, (selected - 1) as nat);
+    }
+}
+
+pub proof fn stripe_drains_only_after_writes(before: Image, entries: Seq<Entry>, stripe: nat,
+    decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), entries_valid(entries, before.visible.len()),
+        model_entries(before, entries, stripe, 0, decisions).ok,
+    ensures model_stripes(before, seq![entries], stripe, decisions).events.len() == entries.len() + 2,
+        model_stripes(before, seq![entries], stripe, decisions).events[entries.len() as int].kind == 1,
+        model_stripes(before, seq![entries], stripe, decisions).events.last().kind == 2,
+        forall|position: int| 0 <= position < entries.len() ==>
+            (#[trigger] model_stripes(before, seq![entries], stripe, decisions).events[position])
+                == event(0, stripe, position as nat, true),
+{
+    reveal_with_fuel(model_stripes, 2);
+    check_entries(before, entries, stripe, 0, decisions);
+    assert(seq![entries].subrange(1, 1) =~= Seq::<Seq<Entry>>::empty());
+}
+
+pub open spec fn successful_decisions() -> spec_fn(nat, nat) -> Decision {
+    |stripe: nat, position: nat| Decision { ok: true, changed: Set::empty(), persisted: Set::empty() }
+}
+
+pub proof fn all_entries_succeed(before: Image, entries: Seq<Entry>, stripe: nat, index: nat)
+    ensures model_entries(before, entries, stripe, index, successful_decisions()).ok,
+    decreases entries.len(),
+{
+    if entries.len() > 0 {
+        all_entries_succeed(backend_write(before, entries[0], successful_decisions()(stripe, index)),
+            entries.subrange(1, entries.len() as int), stripe, index + 1);
+    }
+}
+
+pub proof fn all_stripes_succeed(before: Image, pending: Seq<Seq<Entry>>, stripe: nat)
+    ensures model_stripes(before, pending, stripe, successful_decisions()).ok,
+    decreases pending.len(),
+{
+    if pending.len() > 0 {
+        all_entries_succeed(before, pending[0], stripe, 0);
+        all_stripes_succeed(model_entries(before, pending[0], stripe, 0, successful_decisions()).image,
+            pending.subrange(1, pending.len() as int), stripe + 1);
+    }
+}
+
+pub proof fn arbitrary_successful_flush(before: Image, pending: Seq<Seq<Entry>>)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+    ensures model_flush(before, pending, successful_decisions(), true, Set::empty()).ok,
+        model_flush(before, pending, successful_decisions(), true, Set::empty()).image.durable
+            == visible_stripes(before.visible, pending),
+        forall|position: int| 0 <= position < pending.len() ==>
+            (#[trigger] model_flush(before, pending, successful_decisions(), true, Set::empty()).pending[position]).len() == 0,
+{
+    all_stripes_succeed(before, pending, 0);
+    flush_refinement(before, pending, successful_decisions(), true, Set::empty());
+}
+
+pub proof fn unbounded_pending_coalescing(before: Buffered, offset: nat, values: Seq<Seq<u8>>)
+    ensures buffer_repeated(before, offset, values).backend == before.backend,
+        values.len() > 0 ==> buffer_repeated(before, offset, values).slots
+            == before.slots.insert(offset, values.last()),
+    decreases values.len(),
+{
+    if values.len() > 0 {
+        let first = buffer_application(before, offset, values[0]);
+        let rest = values.subrange(1, values.len() as int);
+        unbounded_pending_coalescing(first, offset, rest);
+        if rest.len() > 0 {
+            assert(rest.last() == values.last());
+            same_offset_coalesces(before.slots, offset, values[0], values.last());
+        }
+    }
+}
+
+pub proof fn stripes_preserve_address(before: Seq<u8>, pending: Seq<Seq<Entry>>, address: int)
+    requires 0 <= address < before.len(),
+        forall|stripe: int, position: int| 0 <= stripe < pending.len()
+            && 0 <= position < pending[stripe].len() ==>
+            !covers(#[trigger] pending[stripe][position], address),
+    ensures visible_stripes(before, pending).len() == before.len(),
+        visible_stripes(before, pending)[address] == before[address],
+    decreases pending.len(),
+{
+    if pending.len() > 0 {
+        assert forall|position: int| 0 <= position < pending[0].len() implies
+            !covers(#[trigger] pending[0][position], address) by {}
+        entries_preserve_address(before, pending[0], address);
+        let rest = pending.subrange(1, pending.len() as int);
+        assert forall|stripe: int, position: int| 0 <= stripe < rest.len()
+            && 0 <= position < rest[stripe].len() implies
+            !covers(#[trigger] rest[stripe][position], address) by {
+            assert(rest[stripe] == pending[stripe + 1]);
+        }
+        stripes_preserve_address(visible_entries(before, pending[0]), rest, address);
+    }
+}
+
+pub proof fn stripes_reflect_last_cover(before: Seq<u8>, pending: Seq<Seq<Entry>>,
+    address: int, selected_stripe: nat, selected_entry: nat)
+    requires 0 <= address < before.len(), selected_stripe < pending.len(),
+        selected_entry < pending[selected_stripe as int].len(),
+        covers(pending[selected_stripe as int][selected_entry as int], address),
+        forall|position: int| selected_entry < position < pending[selected_stripe as int].len() ==>
+            !covers(#[trigger] pending[selected_stripe as int][position], address),
+        forall|stripe: int, position: int| selected_stripe < stripe < pending.len()
+            && 0 <= position < pending[stripe].len() ==>
+            !covers(#[trigger] pending[stripe][position], address),
+    ensures visible_stripes(before, pending)[address]
+        == pending[selected_stripe as int][selected_entry as int].bytes[
+            address - pending[selected_stripe as int][selected_entry as int].offset],
+    decreases selected_stripe,
+{
+    let rest = pending.subrange(1, pending.len() as int);
+    if selected_stripe == 0 {
+        entries_reflect_last_cover(before, pending[0], address, selected_entry);
+        assert forall|stripe: int, position: int| 0 <= stripe < rest.len()
+            && 0 <= position < rest[stripe].len() implies
+            !covers(#[trigger] rest[stripe][position], address) by {
+            assert(rest[stripe] == pending[stripe + 1]);
+        }
+        stripes_preserve_address(visible_entries(before, pending[0]), rest, address);
+    } else {
+        assert(rest[(selected_stripe - 1) as int] == pending[selected_stripe as int]);
+        assert forall|stripe: int, position: int| selected_stripe - 1 < stripe < rest.len()
+            && 0 <= position < rest[stripe].len() implies
+            !covers(#[trigger] rest[stripe][position], address) by {
+            assert(rest[stripe] == pending[stripe + 1]);
+        }
+        visible_entries_length(before, pending[0]);
+        stripes_reflect_last_cover(visible_entries(before, pending[0]), rest, address,
+            (selected_stripe - 1) as nat, selected_entry);
+    }
+}
+
+pub proof fn visible_entries_length(before: Seq<u8>, entries: Seq<Entry>)
+    ensures visible_entries(before, entries).len() == before.len(),
+    decreases entries.len(),
+{
+    if entries.len() > 0 {
+        visible_entries_length(overwrite(before, entries[0]), entries.subrange(1, entries.len() as int));
+    }
+}
+
+pub proof fn arbitrary_order_nonoverlapping_byte(before: Image, pending: Seq<Seq<Entry>>,
+    address: int, selected_stripe: nat, selected_entry: nat)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+        0 <= address < before.visible.len(), selected_stripe < pending.len(),
+        selected_entry < pending[selected_stripe as int].len(),
+        covers(pending[selected_stripe as int][selected_entry as int], address),
+        forall|stripe: int, position: int| 0 <= stripe < pending.len()
+            && 0 <= position < pending[stripe].len()
+            && (stripe != selected_stripe || position != selected_entry) ==>
+            !covers(#[trigger] pending[stripe][position], address),
+    ensures model_flush(before, pending, successful_decisions(), true, Set::empty()).image.durable[address]
+        == pending[selected_stripe as int][selected_entry as int].bytes[
+            address - pending[selected_stripe as int][selected_entry as int].offset],
+{
+    arbitrary_successful_flush(before, pending);
+    assert forall|position: int| selected_entry < position < pending[selected_stripe as int].len() implies
+        !covers(#[trigger] pending[selected_stripe as int][position], address) by {}
+    stripes_reflect_last_cover(before.visible, pending, address, selected_stripe, selected_entry);
+}
+
+pub proof fn coalesced_pending_flush(before: Buffered, offset: nat, values: Seq<Seq<u8>>)
+    requires valid(before.backend), values.len() > 0,
+        offset + values.last().len() <= before.backend.visible.len(),
+    ensures buffer_repeated(before, offset, values).backend == before.backend,
+        buffer_repeated(before, offset, values).slots[offset] == values.last(),
+        model_flush(before.backend,
+            seq![seq![Entry { offset, bytes: buffer_repeated(before, offset, values).slots[offset] }]],
+            successful_decisions(), true, Set::empty()).ok,
+        model_flush(before.backend,
+            seq![seq![Entry { offset, bytes: buffer_repeated(before, offset, values).slots[offset] }]],
+            successful_decisions(), true, Set::empty()).image.durable
+                == overwrite(before.backend.visible, Entry { offset, bytes: values.last() }),
+{
+    unbounded_pending_coalescing(before, offset, values);
+    let entry = Entry { offset, bytes: values.last() };
+    let pending = seq![seq![entry]];
+    assert(entries_valid(pending[0], before.backend.visible.len()));
+    assert(pending_valid(pending, before.backend.visible.len()));
+    arbitrary_successful_flush(before.backend, pending);
+    reveal_with_fuel(visible_stripes, 2);
+    reveal_with_fuel(visible_entries, 2);
+    assert(pending.subrange(1, 1) =~= Seq::<Seq<Entry>>::empty());
+    assert(pending[0].subrange(1, 1) =~= Seq::<Entry>::empty());
+}
+
+pub proof fn localized_sync_error_control()
+{
+    let before = Image { visible: seq![7u8, 9u8], durable: seq![0u8, 0u8],
+        permitted: Map::new(Set::range(0, 2), |address: int| Set::empty().insert(0u8).insert(
+            if address == 0 { 7u8 } else { 9u8 })) };
+    let after = backend_sync(before, false, Set::empty().insert(0));
+    assert(after.visible[0] == 7);
+    assert(after.visible[1] == 9);
+    assert(after.durable[0] == 7);
+    assert(after.durable[1] == 0);
+    assert(after.durable != before.durable);
+    assert(after.durable != before.visible);
+}
+
+pub proof fn flush_sync_order(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+    ensures model_stripes(before, pending, 0, decisions).ok ==>
+        model_flush(before, pending, decisions, sync_ok, persisted).events.last().kind == 3,
+        model_stripes(before, pending, 0, decisions).ok ==>
+            forall|position: int| 0 <= position < model_flush(before, pending, decisions, sync_ok, persisted).events.len() - 1 ==>
+                (#[trigger] model_flush(before, pending, decisions, sync_ok, persisted).events[position]).kind != 3,
+        !model_stripes(before, pending, 0, decisions).ok ==>
+            model_flush(before, pending, decisions, sync_ok, persisted) == model_stripes(before, pending, 0, decisions),
+{
+    check_stripes(before, pending, 0, decisions);
+}
+
+pub enum Boundary {
+    Returned(Run),
+    OpenAbnormal { phase: nat },
+}
+
+pub open spec fn boundary(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>,
+    abnormal_phase: Option<nat>) -> Boundary {
+    match abnormal_phase {
+        Some(phase) => Boundary::OpenAbnormal { phase },
+        None => Boundary::Returned(model_flush(before, pending, decisions, sync_ok, persisted)),
+    }
+}
+
+pub proof fn abnormal_is_not_an_acknowledgement(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>, phase: nat)
+    ensures !(boundary(before, pending, decisions, sync_ok, persisted, Some(phase)) is Returned),
+{
+}
