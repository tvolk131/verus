+use vstd::prelude::*;
+
+verus! {
+
+pub struct Image {
+    pub visible: Seq<u8>,
+    pub durable: Seq<u8>,
+    pub permitted: Map<int, Set<u8>>,
+}
+
+pub struct Entry {
+    pub offset: nat,
+    pub bytes: Seq<u8>,
+}
+
+pub struct Decision {
+    pub ok: bool,
+    pub changed: Set<int>,
+    pub persisted: Set<int>,
+}
+
+pub struct Event {
+    pub kind: nat,
+    pub stripe: nat,
+    pub index: nat,
+    pub ok: bool,
+}
+
+pub struct Chunk {
+    pub image: Image,
+    pub events: Seq<Event>,
+    pub ok: bool,
+    pub successful: nat,
+}
+
+pub struct Run {
+    pub image: Image,
+    pub pending: Seq<Seq<Entry>>,
+    pub events: Seq<Event>,
+    pub ok: bool,
+    pub completed: nat,
+}
+
+pub struct Buffered {
+    pub backend: Image,
+    pub slots: Map<nat, Seq<u8>>,
+}
+
+pub open spec fn buffer_application(before: Buffered, offset: nat, bytes: Seq<u8>) -> Buffered {
+    Buffered { backend: before.backend, slots: before.slots.insert(offset, bytes) }
+}
+
+pub open spec fn buffer_repeated(before: Buffered, offset: nat, values: Seq<Seq<u8>>) -> Buffered
+    decreases values.len(),
+{
+    if values.len() == 0 { before } else {
+        buffer_repeated(buffer_application(before, offset, values[0]), offset,
+            values.subrange(1, values.len() as int))
+    }
+}
+
+pub open spec fn valid(image: Image) -> bool {
+    &&& image.visible.len() == image.durable.len()
+    &&& forall|address: int| #[trigger] image.permitted.dom().contains(address)
+        <==> 0 <= address < image.visible.len()
+    &&& forall|address: int| 0 <= address < image.visible.len() ==>
+        #[trigger] image.permitted[address].contains(image.visible[address])
+        && image.permitted[address].contains(image.durable[address])
+}
+
+pub open spec fn entry_valid(entry: Entry, length: nat) -> bool {
+    entry.offset + entry.bytes.len() <= length
+}
+
+pub open spec fn entries_valid(entries: Seq<Entry>, length: nat) -> bool {
+    forall|position: int| 0 <= position < entries.len() ==>
+        entry_valid(#[trigger] entries[position], length)
+}
+
+pub open spec fn pending_valid(pending: Seq<Seq<Entry>>, length: nat) -> bool {
+    forall|stripe: int| 0 <= stripe < pending.len() ==>
+        entries_valid(#[trigger] pending[stripe], length)
+}
+
+pub open spec fn clean(bytes: Seq<u8>) -> Image {
+    Image { visible: bytes, durable: bytes,
+        permitted: Map::new(Set::range(0, bytes.len() as int),
+            |address: int| Set::empty().insert(bytes[address])) }
+}
+
+pub open spec fn overwrite(visible: Seq<u8>, entry: Entry) -> Seq<u8> {
+    Seq::new(visible.len(), |address: int|
+        if entry.offset <= address < entry.offset + entry.bytes.len() {
+            entry.bytes[address - entry.offset]
+        } else { visible[address] })
+}
+
+pub open spec fn write_visible(before: Image, entry: Entry, decision: Decision) -> Seq<u8> {
+    Seq::new(before.visible.len(), |address: int|
+        if entry.offset <= address < entry.offset + entry.bytes.len()
+            && (decision.ok || decision.changed.contains(address)) {
+            entry.bytes[address - entry.offset]
+        } else { before.visible[address] })
+}
+
+pub open spec fn backend_write(before: Image, entry: Entry, decision: Decision) -> Image {
+    let visible = write_visible(before, entry, decision);
+    Image {
+        visible,
+        durable: Seq::new(before.durable.len(), |address: int|
+            if decision.persisted.contains(address) { visible[address] }
+            else { before.durable[address] }),
+        permitted: Map::new(before.permitted.dom(), |address: int|
+            before.permitted[address].insert(visible[address])),
+    }
+}
+
+pub open spec fn backend_sync(before: Image, ok: bool, persisted: Set<int>) -> Image {
+    if ok { clean(before.visible) } else {
+        Image { visible: before.visible,
+            durable: Seq::new(before.durable.len(), |address: int|
+                if persisted.contains(address) { before.visible[address] }
+                else { before.durable[address] }),
+            permitted: before.permitted }
+    }
+}
+
+pub open spec fn event(kind: nat, stripe: nat, index: nat, ok: bool) -> Event {
+    Event { kind, stripe, index, ok }
+}
+
+pub open spec fn no_sync(events: Seq<Event>) -> bool {
+    forall|position: int| 0 <= position < events.len() ==>
+        (#[trigger] events[position]).kind != 3
+}
+
+pub open spec fn model_entries(before: Image, entries: Seq<Entry>, stripe: nat,
+    index: nat, decisions: spec_fn(nat, nat) -> Decision) -> Chunk
+    decreases entries.len(),
+{
+    if entries.len() == 0 {
+        Chunk { image: before, events: Seq::empty(), ok: true, successful: 0 }
+    } else {
+        let decision = decisions(stripe, index);
+        let written = backend_write(before, entries[0], decision);
+        let attempt = event(0, stripe, index, decision.ok);
+        if !decision.ok {
+            Chunk { image: written, events: seq![attempt], ok: false, successful: 0 }
+        } else {
+            let tail = model_entries(written, entries.subrange(1, entries.len() as int),
+                stripe, index + 1, decisions);
+            Chunk { image: tail.image, events: seq![attempt] + tail.events,
+                ok: tail.ok, successful: tail.successful + 1 }
+        }
+    }
+}
+
+pub open spec fn visible_entries(before: Seq<u8>, entries: Seq<Entry>) -> Seq<u8>
+    decreases entries.len(),
+{
+    if entries.len() == 0 { before } else {
+        visible_entries(overwrite(before, entries[0]), entries.subrange(1, entries.len() as int))
+    }
+}
+
+pub open spec fn model_stripes(before: Image, pending: Seq<Seq<Entry>>, stripe: nat,
+    decisions: spec_fn(nat, nat) -> Decision) -> Run
+    decreases pending.len(),
+{
+    if pending.len() == 0 {
+        Run { image: before, pending: Seq::empty(), events: seq![event(2, stripe, 0, true)],
+            ok: true, completed: 0 }
+    } else {
+        let head = model_entries(before, pending[0], stripe, 0, decisions);
+        if !head.ok {
+            Run { image: head.image, pending, events: head.events, ok: false, completed: 0 }
+        } else {
+            let tail = model_stripes(head.image, pending.subrange(1, pending.len() as int),
+                stripe + 1, decisions);
+            Run { image: tail.image, pending: seq![Seq::empty()] + tail.pending,
+                events: head.events + seq![event(1, stripe, 0, true)] + tail.events,
+                ok: tail.ok, completed: tail.completed + 1 }
+        }
+    }
+}
+
+pub open spec fn visible_stripes(before: Seq<u8>, pending: Seq<Seq<Entry>>) -> Seq<u8>
+    decreases pending.len(),
+{
+    if pending.len() == 0 { before } else {
+        visible_stripes(visible_entries(before, pending[0]), pending.subrange(1, pending.len() as int))
+    }
+}
+
+pub open spec fn model_flush(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>) -> Run {
+    let drained = model_stripes(before, pending, 0, decisions);
+    if !drained.ok { drained } else {
+        Run { image: backend_sync(drained.image, sync_ok, persisted), pending: drained.pending,
+            events: drained.events + seq![event(3, 0, 0, sync_ok)], ok: sync_ok,
+            completed: drained.completed }
+    }
+}
+
+pub proof fn clean_valid(bytes: Seq<u8>)
+    ensures valid(clean(bytes)),
+{
+    vstd::set_lib::lemma_int_range(0, bytes.len() as int);
+}
+
+pub proof fn write_valid(before: Image, entry: Entry, decision: Decision)
+    requires valid(before), entry_valid(entry, before.visible.len()),
+    ensures valid(backend_write(before, entry, decision)),
+        backend_write(before, entry, decision).visible.len() == before.visible.len(),
+        decision.ok ==> backend_write(before, entry, decision).visible == overwrite(before.visible, entry),
+        forall|address: int| 0 <= address < before.visible.len()
+            && !(entry.offset <= address < entry.offset + entry.bytes.len()) ==>
+            backend_write(before, entry, decision).visible[address] == before.visible[address],
+{
+    let after = backend_write(before, entry, decision);
+    assert forall|address: int| 0 <= address < after.visible.len() implies
+        #[trigger] after.permitted[address].contains(after.visible[address])
+        && after.permitted[address].contains(after.durable[address]) by {
+        assert(before.permitted[address].contains(before.visible[address]));
+        assert(before.permitted[address].contains(before.durable[address]));
+    }
+    if decision.ok {
+        assert(after.visible =~= overwrite(before.visible, entry));
+    }
+}
+
+pub proof fn sync_valid(before: Image, ok: bool, persisted: Set<int>)
+    requires valid(before),
+    ensures valid(backend_sync(before, ok, persisted)),
+        backend_sync(before, ok, persisted).visible == before.visible,
+        ok ==> backend_sync(before, ok, persisted).durable == before.visible,
+{
+    if ok { clean_valid(before.visible); } else {
+        let after = backend_sync(before, ok, persisted);
+        assert forall|address: int| 0 <= address < after.visible.len() implies
+            #[trigger] after.permitted[address].contains(after.visible[address])
+            && after.permitted[address].contains(after.durable[address]) by {
+            assert(before.permitted[address].contains(before.visible[address]));
+            assert(before.permitted[address].contains(before.durable[address]));
+        }
+    }
+}
+
+pub proof fn concat_no_sync(left: Seq<Event>, right: Seq<Event>)
+    requires no_sync(left), no_sync(right),
+    ensures no_sync(left + right),
+{
+    assert forall|position: int| 0 <= position < (left + right).len() implies
+        (#[trigger] (left + right)[position]).kind != 3 by {
+        if position < left.len() { assert(left[position].kind != 3); }
+        else { assert(right[position - left.len()].kind != 3); }
+    }
+}
+
+pub proof fn check_entries(before: Image, entries: Seq<Entry>, stripe: nat,
+    index: nat, decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), entries_valid(entries, before.visible.len()),
+    ensures valid(model_entries(before, entries, stripe, index, decisions).image),
+        model_entries(before, entries, stripe, index, decisions).image.visible.len() == before.visible.len(),
+        no_sync(model_entries(before, entries, stripe, index, decisions).events),
+        model_entries(before, entries, stripe, index, decisions).successful <= entries.len(),
+        model_entries(before, entries, stripe, index, decisions).ok ==>
+            model_entries(before, entries, stripe, index, decisions).successful == entries.len(),
+        !model_entries(before, entries, stripe, index, decisions).ok ==>
+            model_entries(before, entries, stripe, index, decisions).successful < entries.len(),
+        model_entries(before, entries, stripe, index, decisions).ok ==>
+            model_entries(before, entries, stripe, index, decisions).image.visible
+                == visible_entries(before.visible, entries),
+        model_entries(before, entries, stripe, index, decisions).events.len()
+            == model_entries(before, entries, stripe, index, decisions).successful
+                + if model_entries(before, entries, stripe, index, decisions).ok { 0nat } else { 1nat },
+        forall|position: int| 0 <= position < model_entries(before, entries, stripe, index, decisions).events.len() ==>
+            (#[trigger] model_entries(before, entries, stripe, index, decisions).events[position])
+                == event(0, stripe, index + position as nat,
+                    position < model_entries(before, entries, stripe, index, decisions).successful),
+    decreases entries.len(),
+{
+    if entries.len() > 0 {
+        let decision = decisions(stripe, index);
+        let written = backend_write(before, entries[0], decision);
+        write_valid(before, entries[0], decision);
+        if decision.ok {
+            let rest = entries.subrange(1, entries.len() as int);
+            assert(entries_valid(rest, written.visible.len())) by {
+                assert forall|position: int| 0 <= position < rest.len() implies
+                    entry_valid(#[trigger] rest[position], written.visible.len()) by {
+                    assert(rest[position] == entries[position + 1]);
+                }
+            }
+            check_entries(written, rest, stripe, index + 1, decisions);
+            concat_no_sync(seq![event(0, stripe, index, true)],
+                model_entries(written, rest, stripe, index + 1, decisions).events);
+            let result = model_entries(before, entries, stripe, index, decisions);
+            let tail = model_entries(written, rest, stripe, index + 1, decisions);
+            assert forall|position: int| 0 <= position < result.events.len() implies
+                (#[trigger] result.events[position]) == event(0, stripe, index + position as nat,
+                    position < result.successful) by {
+                if position > 0 {
+                    assert(result.events[position] == tail.events[position - 1]);
+                    assert(tail.events[position - 1] == event(0, stripe,
+                        index + 1 + (position - 1) as nat, position - 1 < tail.successful));
+                }
+            }
+        }
+    }
+}
+
+pub proof fn check_stripes(before: Image, pending: Seq<Seq<Entry>>, stripe: nat,
+    decisions: spec_fn(nat, nat) -> Decision)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+    ensures valid(model_stripes(before, pending, stripe, decisions).image),
+        model_stripes(before, pending, stripe, decisions).image.visible.len() == before.visible.len(),
+        no_sync(model_stripes(before, pending, stripe, decisions).events),
+        model_stripes(before, pending, stripe, decisions).pending.len() == pending.len(),
+        model_stripes(before, pending, stripe, decisions).completed <= pending.len(),
+        model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).completed == pending.len(),
+        !model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).completed < pending.len(),
+        forall|position: int| 0 <= position < pending.len() ==>
+            (#[trigger] model_stripes(before, pending, stripe, decisions).pending[position])
+                == if position < model_stripes(before, pending, stripe, decisions).completed {
+                    Seq::<Entry>::empty() } else { pending[position] },
+        model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).image.visible
+                == visible_stripes(before.visible, pending),
+        model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).events.last().kind == 2,
+        !model_stripes(before, pending, stripe, decisions).ok ==>
+            model_stripes(before, pending, stripe, decisions).events.len() > 0
+            && model_stripes(before, pending, stripe, decisions).events.last().kind == 0
+            && !model_stripes(before, pending, stripe, decisions).events.last().ok,
+        forall|position: int| 0 <= position < model_stripes(before, pending, stripe, decisions).events.len()
+            && (#[trigger] model_stripes(before, pending, stripe, decisions).events[position]).kind == 1 ==>
+                stripe <= model_stripes(before, pending, stripe, decisions).events[position].stripe
+                    < stripe + model_stripes(before, pending, stripe, decisions).completed,
+    decreases pending.len(),
+{
+    if pending.len() > 0 {
+        check_entries(before, pending[0], stripe, 0, decisions);
+        let head = model_entries(before, pending[0], stripe, 0, decisions);
+        if head.ok {
+            let rest = pending.subrange(1, pending.len() as int);
+            assert(pending_valid(rest, head.image.visible.len())) by {
+                assert forall|position: int| 0 <= position < rest.len() implies
+                    entries_valid(#[trigger] rest[position], head.image.visible.len()) by {
+                    assert(rest[position] == pending[position + 1]);
+                }
+            }
+            check_stripes(head.image, rest, stripe + 1, decisions);
+            let tail = model_stripes(head.image, rest, stripe + 1, decisions);
+            concat_no_sync(head.events, seq![event(1, stripe, 0, true)]);
+            concat_no_sync(head.events + seq![event(1, stripe, 0, true)], tail.events);
+            let result = model_stripes(before, pending, stripe, decisions);
+            assert forall|position: int| 0 <= position < pending.len() implies
+                (#[trigger] result.pending[position])
+                    == if position < result.completed { Seq::<Entry>::empty() } else { pending[position] } by {
+                if position > 0 {
+                    assert(result.pending[position] == tail.pending[position - 1]);
+                    assert(tail.pending[position - 1] == if position - 1 < tail.completed {
+                        Seq::<Entry>::empty() } else { rest[position - 1] });
+                }
+            }
+            assert forall|position: int| 0 <= position < result.events.len()
+                && (#[trigger] result.events[position]).kind == 1 implies
+                    stripe <= result.events[position].stripe < stripe + result.completed by {
+                if position < head.events.len() {
+                    assert(head.events[position].kind == 0);
+                } else if position > head.events.len() {
+                    let tail_position = position - head.events.len() - 1;
+                    assert(result.events[position] == tail.events[tail_position]);
+                    assert(stripe + 1 <= tail.events[tail_position].stripe
+                        < stripe + 1 + tail.completed);
+                }
+            }
+        }
+    }
+}
