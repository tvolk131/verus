+pub proof fn flush_refinement(before: Image, pending: Seq<Seq<Entry>>,
+    decisions: spec_fn(nat, nat) -> Decision, sync_ok: bool, persisted: Set<int>)
+    requires valid(before), pending_valid(pending, before.visible.len()),
+    ensures valid(model_flush(before, pending, decisions, sync_ok, persisted).image),
+        model_flush(before, pending, decisions, sync_ok, persisted).ok ==>
+            model_flush(before, pending, decisions, sync_ok, persisted).image.durable
+                == visible_stripes(before.visible, pending),
+        model_stripes(before, pending, 0, decisions).ok ==>
+            forall|position: int| 0 <= position < pending.len() ==>
+                (#[trigger] model_flush(before, pending, decisions, sync_ok, persisted).pending[position]).len() == 0,
+        !model_stripes(before, pending, 0, decisions).ok ==>
+            no_sync(model_flush(before, pending, decisions, sync_ok, persisted).events),
+        model_stripes(before, pending, 0, decisions).ok ==>
+            model_flush(before, pending, decisions, sync_ok, persisted).events.last().kind == 3,
+{
+    check_stripes(before, pending, 0, decisions);
+    let drained = model_stripes(before, pending, 0, decisions);
+    if drained.ok {
+        sync_valid(drained.image, sync_ok, persisted);
+        assert forall|position: int| 0 <= position < pending.len() implies
+            (#[trigger] model_flush(before, pending, decisions, sync_ok, persisted).pending[position]).len() == 0 by {
+            assert(drained.pending[position] == Seq::<Entry>::empty());
+        }
+    }
+}
