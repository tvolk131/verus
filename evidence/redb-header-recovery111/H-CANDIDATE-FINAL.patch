+pub fn stage_two_phase(header: &mut DatabaseHeader, transaction_id: TransactionId,
+    user_root: Option<BtreeHeader>, system_root: Option<BtreeHeader>)
+    -> (result: ([u8; 320], [u8; 320]))
+    requires stage_domain(*old(header), transaction_id, user_root, system_root),
+    ensures
+        *final(header) == committed_header(prepared_header(*old(header),
+            transaction_id, user_root, system_root)),
+        result.0@ == database_bytes(prepared_header(*old(header),
+            transaction_id, user_root, system_root), true),
+        result.1@ == database_bytes(*final(header), true),
+        header_roundtrip_domain(prepared_header(*old(header), transaction_id, user_root, system_root)),
+        header_roundtrip_domain(*final(header)),
+        final(header).transaction_slots@[old(header).primary_slot as int]
+            == old(header).transaction_slots@[old(header).primary_slot as int],
+        prepared_header(*old(header), transaction_id, user_root, system_root).two_phase_commit
+            == old(header).two_phase_commit,
+        prepared_header(*old(header), transaction_id, user_root, system_root).primary_unflushed
+            == old(header).primary_unflushed,
+        final(header).two_phase_commit,
+        !final(header).primary_unflushed,
+        final(header).primary_slot == old(header).primary_slot ^ 1,
+        final(header).transaction_slots@[final(header).primary_slot as int].transaction_id == transaction_id,
+        final(header).transaction_slots@[final(header).primary_slot as int].user_root == user_root,
+        final(header).transaction_slots@[final(header).primary_slot as int].system_root == system_root,
+{
+    let ghost before = *header;
+    header.write_secondary_slot(transaction_id, user_root, system_root);
+    proof {
+        prepared_shape(before, *header, transaction_id, user_root, system_root);
+    }
+    let first = header.to_bytes(true);
+    let ghost prepared = *header;
+    header.swap_primary_slot();
+    header.two_phase_commit = true;
+    header.primary_unflushed = false;
+    proof {
+        assert(header.transaction_slots@ == prepared.transaction_slots@);
+        assert(header.transaction_slots == prepared.transaction_slots);
+        assert(*header == committed_header(prepared));
+        other_slot_bounds(before.primary_slot);
+    }
+    let final_bytes = header.to_bytes(true);
+    (first, final_bytes)
+}
