+pub proof fn prepared_shape(before: DatabaseHeader, after: DatabaseHeader,
+    transaction_id: TransactionId, user_root: Option<BtreeHeader>, system_root: Option<BtreeHeader>)
+    requires
+        stage_domain(before, transaction_id, user_root, system_root),
+        metadata(after) == metadata(before),
+        after.transaction_slots@ == before.transaction_slots@.update(
+            (before.primary_slot ^ 1) as int, TransactionHeader {
+                version: before.transaction_slots@[(before.primary_slot ^ 1) as int].version,
+                user_root, system_root, transaction_id, corrupt_bytes: None }),
+    ensures
+        after == prepared_header(before, transaction_id, user_root, system_root),
+        header_roundtrip_domain(after),
+        after.transaction_slots@[before.primary_slot as int]
+            == before.transaction_slots@[before.primary_slot as int],
+{
+    let primary = before.primary_slot;
+    other_slot_bounds(primary);
+    if primary == 0 {
+        assert(primary ^ 1 == 1) by(bit_vector)
+            requires primary == 0;
+    } else {
+        assert(primary == 1);
+        assert(primary ^ 1 == 0) by(bit_vector)
+            requires primary == 1;
+    }
+    let expected = prepared_header(before, transaction_id, user_root, system_root);
+    assert(after.transaction_slots@ == expected.transaction_slots@);
+    assert(after.transaction_slots == expected.transaction_slots);
+}
