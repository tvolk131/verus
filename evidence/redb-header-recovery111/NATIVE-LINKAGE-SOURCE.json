        "        start.control == acknowledgement::initial(config), run(start, config, actions).control.status == 1,",
        "    ensures ({",
        "        let final_state = run(start, config, actions);",
        "        !final_state.blocked",
        "            && certificate(final_state, final_state.first_index, 24, final_state.first_header)",
        "            && certificate(final_state, final_state.second_index, 28, final_state.second_header)",
        "            && final_state.first_index < final_state.second_index",
        "            && final_state.image.durable.subrange(0, HEADER_BYTES as int) == final_state.second_header",
        "            && drained(final_state.pending)",
        "            && 0 <= final_state.control.first_write < final_state.control.first_barrier",
        "                < final_state.control.second_write < final_state.control.final_barrier",
        "                < final_state.control.publication < final_state.control.acknowledgement",
        "    }),",
        "{",
        "    checked_run(start, config, actions);",
        "    acknowledgement::public_ok_has_two_successful_barriers(config, signals(start, config, actions));"
