+    let inner_error = projection(&context, outer_error, "Err", 0);
+    let tuple = projection(&context, inner_error, "Err", 0);
+    let tuple_variant = context.shape(&tuple.typ).unwrap()[0].0.clone();
+    let second = projection(&context, tuple, &tuple_variant, 1);
+    roundtrip(&context, equality(second, input("y")));
