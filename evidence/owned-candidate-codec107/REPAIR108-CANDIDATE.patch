+use super::*;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+const SCHEMA: &str = "owned-proposal-loop-free-v1";
+const MAX_BYTES: usize = 262_144;
+const MAX_NODES: usize = 2048;
+const MAX_EXPANDED: usize = 4096;
+const MAX_DEPTH: usize = 32;
+const MAX_TYPES: usize = 128;
+const MAX_TYPE_DEPTH: usize = 12;
+type CodecResult<Value> = Result<Value, &'static str>;
+type Shape = Vec<(Ident, Vec<(Ident, Typ)>)>;
+
+#[derive(Clone, Debug)]
+struct Policy {
+    compiler: String,
+    configuration: String,
+    target: String,
+    trust: String,
+    models: String,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Wire {
+    schema: String,
+    key: String,
+    dependencies: Vec<String>,
+    nodes: Vec<NodeData>,
+    pre: usize,
+    post: usize,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NodeData {
+    typ: usize,
+    data: Data,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "args", deny_unknown_fields)]
+enum Data {
+    Bool(bool),
+    Integer(String),
+    Parameter(usize),
+    Result,
+    Unary(UnaryOp, usize),
+    Binary(BinaryOp, usize, usize),
+    Logical(LogicalOp, usize, usize),
+    If(usize, usize, usize),
+    Constructor(String, Vec<usize>),
+    Variant(String, usize),
+    Field(String, usize, usize),
+    Observation(usize, Vec<usize>),
+}
+
+impl Data {
+    fn children(&self) -> Vec<usize> {
+        match self {
+            Self::Unary(_, operand) | Self::Variant(_, operand) | Self::Field(_, _, operand) => {
+                vec![*operand]
+            }
+            Self::Binary(_, left, right) | Self::Logical(_, left, right) => vec![*left, *right],
+            Self::If(condition, yes, no) => vec![*condition, *yes, *no],
+            Self::Constructor(_, fields) | Self::Observation(_, fields) => fields.clone(),
+            _ => vec![],
+        }
+    }
+}
+
+struct Context<'source> {
+    function: &'source Function,
+    datatypes: &'source [Datatype],
+    observations: &'source [Function],
+    types: Vec<Typ>,
+    type_heights: Vec<usize>,
+    dependencies: Vec<String>,
+    key: String,
+}
+
+fn digest(value: &str) -> String {
+    Sha256::digest(value.as_bytes())
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+fn leaf_body(function: &Function, observation: bool) -> CodecResult<()> {
+    let body = function.x.body.as_ref().ok_or("missing current body")?;
+    let mut remaining = MAX_EXPANDED;
+    crate::ast_visitor::expr_visitor_check(body, &mut |_, expression| {
+        remaining = remaining
+            .checked_sub(1)
+            .ok_or_else(|| unsupported(&expression.span, "codec source budget"))?;
+        let forbidden = matches!(
+            &expression.x,
+            ExprX::Loop { .. }
+                | ExprX::Closure(..)
+                | ExprX::Quant(..)
+                | ExprX::WithTriggers { .. }
+                | ExprX::AssertAssume { .. }
+        );
+        let call = match &expression.x {
+            ExprX::Call {
+                target: CallTarget::Fun(kind, name, ..),
+                ..
+            } => {
+                observation
+                    || match kind {
+                        CallTargetKind::Static => name == &function.x.name,
+                        CallTargetKind::DynamicResolved { resolved, .. } => {
+                            resolved == &function.x.name
+                        }
+                        _ => true,
+                    }
+            }
+            ExprX::Call { .. } => true,
+            _ => false,
+        };
+        if forbidden || call {
+            Err(unsupported(
+                &expression.span,
+                "codec requires loop-free nonrecursive source",
+            ))
+        } else {
+            Ok(())
+        }
+    })
+    .map_err(|_| "unsupported current body")
+}
+
+impl<'source> Context<'source> {
+    fn new(
+        function: &'source Function,
+        datatypes: &'source [Datatype],
+        observations: &'source [Function],
+        dependencies: &[String],
+        policy: &Policy,
+    ) -> CodecResult<Self> {
+        if [
+            &policy.compiler,
+            &policy.configuration,
+            &policy.target,
+            &policy.trust,
+            &policy.models,
+        ]
+        .iter()
+        .any(|component| component.is_empty() || component.len() > 16_384)
+            || dependencies.len() > 128
+            || observations.len() > 32
+            || datatypes.len() > 128
+        {
+            return Err("invalid identity inputs");
+        }
+        let mut dependencies = dependencies.to_vec();
+        dependencies.sort();
+        if dependencies.iter().any(|key| {
+            key.len() != 64
+                || !key
+                    .bytes()
+                    .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        }) || dependencies.windows(2).any(|pair| pair[0] == pair[1])
+        {
+            return Err("invalid dependency keys");
+        }
+        let all = observations
+            .iter()
+            .map(|item| (item.x.name.clone(), item.clone()))
+            .collect();
+        validate_signature(function, &all, datatypes).map_err(|_| "ineligible owned source")?;
+        if !function.x.typ_params.is_empty() || !function.x.typ_bounds.is_empty() {
+            return Err("generic source unsupported");
+        }
+        leaf_body(function, false)?;
+        for (index, observation) in observations.iter().enumerate() {
+            if !is_pure_observation(observation)
+                || !matches!(observation.x.kind, FunctionKind::Static)
+                || !matches!(observation.x.item_kind, ItemKind::Function)
+                || observation.x.inner_ret.x.mode != Mode::Spec
+                || observation.x.outer_ret.x.mode != Mode::Spec
+                || !same(
+                    &observation.x.inner_ret.x.typ,
+                    &observation.x.outer_ret.x.typ,
+                )
+                || !observation.x.typ_params.is_empty()
+                || !observation.x.typ_bounds.is_empty()
+                || observation.x.proxy.is_some()
+                || observation.x.attrs.is_external_body
+                || observation
+                    .x
+                    .params
+                    .iter()
+                    .any(|parameter| parameter.x.mode != Mode::Spec)
+                || observations[..index]
+                    .iter()
+                    .any(|prior| prior.x.name == observation.x.name)
+                || observation.x.name == function.x.name
+            {
+                return Err("unapproved observation");
+            }
+            leaf_body(observation, true)?;
+        }
+        for (index, parameter) in function.x.params.iter().enumerate() {
+            if parameter.x.name == function.x.inner_ret.x.name
+                || function.x.params[..index]
+                    .iter()
+                    .any(|prior| prior.x.name == parameter.x.name)
+            {
+                return Err("ambiguous signature slots");
+            }
+        }
+        let key = digest(&format!(
+            "{SCHEMA}:{function:?}:{datatypes:?}:{observations:?}:{dependencies:?}:{policy:?}"
+        ));
+        let mut context = Self {
+            function,
+            datatypes,
+            observations,
+            types: vec![],
+            type_heights: vec![],
+            dependencies,
+            key,
+        };
+        context.add_type(&bool_typ(), &mut vec![])?;
+        context.add_type(&int_typ(), &mut vec![])?;
+        for parameter in function.x.params.iter() {
+            context.add_type(&parameter.x.typ, &mut vec![])?;
+        }
+        context.add_type(&function.x.inner_ret.x.typ, &mut vec![])?;
+        for observation in observations {
+            for parameter in observation.x.params.iter() {
+                context.add_type(&parameter.x.typ, &mut vec![])?;
+            }
+            context.add_type(&observation.x.inner_ret.x.typ, &mut vec![])?;
+        }
+        Ok(context)
+    }
+
+    fn shape(&self, typ: &Typ) -> CodecResult<Shape> {
+        let TypX::Datatype(datatype, arguments, _) = &**typ else {
+            return Err("not a structural value");
+        };
+        if let Dt::Tuple(arity) = datatype {
+            if *arity != arguments.len() || *arity > 8 {
+                return Err("tuple arity");
+            }
+            return Ok(vec![(
+                crate::def::prefix_tuple_variant(*arity),
+                arguments
+                    .iter()
+                    .enumerate()
+                    .map(|(index, typ)| (crate::def::positional_field_ident(index), typ.clone()))
+                    .collect(),
+            )]);
+        }
+        if let Some(payload) = option(typ) {
+            return Ok(vec![
+                (Arc::new("None".into()), vec![]),
+                (
+                    Arc::new("Some".into()),
+                    vec![(crate::def::positional_field_ident(0), payload.clone())],
+                ),
+            ]);
+        }
+        if let Some((success, failure)) = sums::result(typ) {
+            return Ok(vec![
+                (
+                    Arc::new("Ok".into()),
+                    vec![(crate::def::positional_field_ident(0), success.clone())],
+                ),
+                (
+                    Arc::new("Err".into()),
+                    vec![(crate::def::positional_field_ident(0), failure.clone())],
+                ),
+            ]);
+        }
+        if let Some(variants) = records::shape::variants(typ, self.datatypes) {
+            return Ok(variants);
+        }
+        if let Some(fields) = records::shape::fields(typ, self.datatypes) {
+            if let Some((first, _)) = fields.first() {
+                return Ok(vec![(
+                    first.variant.clone(),
+                    fields
+                        .iter()
+                        .map(|(field, typ)| (field.field.clone(), typ.clone()))
+                        .collect(),
+                )]);
+            }
+        }
+        Err("unsupported datatype")
+    }
+
+    fn add_type(&mut self, typ: &Typ, active: &mut Vec<Typ>) -> CodecResult<usize> {
+        if active.len() >= MAX_TYPE_DEPTH || active.iter().any(|ancestor| same(ancestor, typ)) {
+            return Err("recursive or deep type");
+        }
+        if let Some(index) = self.types.iter().position(|known| same(known, typ)) {
+            let height = self.type_heights[index];
+            if active.len() + height > MAX_TYPE_DEPTH {
+                return Err("recursive or deep type");
+            }
+            return Ok(height);
+        }
+        if self.types.len() >= MAX_TYPES {
+            return Err("type budget");
+        }
+        active.push(typ.clone());
+        let mut height = 1;
+        match &**typ {
+            TypX::Bool
+            | TypX::Int(
+                IntRange::Int
+                | IntRange::Nat
+                | IntRange::USize
+                | IntRange::ISize
+                | IntRange::U(8 | 16 | 32 | 64 | 128)
+                | IntRange::I(8 | 16 | 32 | 64 | 128),
+            ) => {}
+            TypX::Datatype(..) => {
+                for (_, fields) in self.shape(typ)? {
+                    for (_, field_type) in fields {
+                        height = height.max(1 + self.add_type(&field_type, active)?);
+                    }
+                }
+            }
+            _ => return Err("unsupported type"),
+        }
+        active.pop();
+        if self.types.len() >= MAX_TYPES {
+            return Err("type budget");
+        }
+        self.types.push(typ.clone());
+        self.type_heights.push(height);
+        Ok(height)
+    }
+
+    fn slot(&self, typ: &Typ) -> CodecResult<usize> {
+        self.types
+            .iter()
+            .position(|current| same(current, typ))
+            .ok_or("type outside current context")
+    }
+
+    fn variant(&self, typ: &Typ, name: &str) -> CodecResult<Vec<(Ident, Typ)>> {
+        self.shape(typ)?
+            .into_iter()
+            .find(|(variant, _)| variant.as_str() == name)
+            .map(|(_, fields)| fields)
+            .ok_or("unknown variant")
+    }
+
+    fn encode_expression(
+        &self,
+        expression: &Expr,
+        nodes: &mut Vec<NodeData>,
+        depth: usize,
+    ) -> CodecResult<usize> {
+        if depth >= MAX_DEPTH || nodes.len() >= MAX_NODES {
+            return Err("expression budget");
+        }
+        let mut child = |operand: &Expr| self.encode_expression(operand, nodes, depth + 1);
+        let data = match &expression.x {
+            ExprX::Const(Constant::Bool(value)) => Data::Bool(*value),
+            ExprX::Const(Constant::Int(value)) if value.bits() <= 256 => {
+                Data::Integer(value.to_string())
+            }
+            ExprX::Var(name) => {
+                if name == &self.function.x.inner_ret.x.name {
+                    Data::Result
+                } else {
+                    Data::Parameter(
+                        self.function
+                            .x
+                            .params
+                            .iter()
+                            .position(|parameter| &parameter.x.name == name)
+                            .ok_or("unbound variable")?,
+                    )
+                }
+            }
+            ExprX::Unary(operator, operand) => Data::Unary(*operator, child(operand)?),
+            ExprX::Binary(operator, left, right) => {
+                Data::Binary(*operator, child(left)?, child(right)?)
+            }
+            ExprX::Logical(operator, left, right) => {
+                Data::Logical(*operator, child(left)?, child(right)?)
+            }
+            ExprX::If(condition, yes, Some(no)) => {
+                Data::If(child(condition)?, child(yes)?, child(no)?)
+            }
+            ExprX::Ctor(datatype, variant, fields, None) => {
+                if !matches!(&*expression.typ, TypX::Datatype(current, ..) if current == datatype) {
+                    return Err("constructor datatype mismatch");
+                }
+                let layout = self.variant(&expression.typ, variant)?;
+                if fields.len() != layout.len()
+                    || fields
+                        .iter()
+                        .zip(&layout)
+                        .any(|(field, (name, typ))| &field.name != name || !same(&field.a.typ, typ))
+                {
+                    return Err("constructor fields mismatch");
+                }
+                Data::Constructor(
+                    variant.to_string(),
+                    fields
+                        .iter()
+                        .map(|field| child(&field.a))
+                        .collect::<CodecResult<_>>()?,
+                )
+            }
+            ExprX::UnaryOpr(UnaryOpr::IsVariant { datatype, variant }, operand) => {
+                if !matches!(&*operand.typ, TypX::Datatype(current, ..) if current == datatype) {
+                    return Err("variant datatype mismatch");
+                }
+                Data::Variant(variant.to_string(), child(operand)?)
+            }
+            ExprX::UnaryOpr(UnaryOpr::Field(field), operand) => {
+                if field.get_variant
+                    || field.check != VariantCheck::None
+                    || !matches!(&*operand.typ, TypX::Datatype(current, ..) if current == &field.datatype)
+                {
+                    return Err("unsupported field operation");
+                }
+                let layout = self.variant(&operand.typ, &field.variant)?;
+                let index = layout
+                    .iter()
+                    .position(|(name, _)| name == &field.field)
+                    .ok_or("unknown field")?;
+                Data::Field(field.variant.to_string(), index, child(operand)?)
+            }
+            ExprX::Call {
+                target:
+                    CallTarget::Fun(CallTargetKind::Static, name, types, implementations, attributes),
+                args,
+                post_args: None,
+                body: None,
+            } if types.is_empty()
+                && implementations.is_empty()
+                && !attributes.const_var
+                && !attributes.assume_external_allowed
+                && attributes.autospec == AutospecUsage::Final =>
+            {
+                let index = self
+                    .observations
+                    .iter()
+                    .position(|observation| &observation.x.name == name)
+                    .ok_or("unapproved call")?;
+                Data::Observation(
+                    index,
+                    args.iter().map(&mut child).collect::<CodecResult<_>>()?,
+                )
+            }
+            _ => return Err("unsupported expression"),
+        };
+        if nodes.len() >= MAX_NODES {
+            return Err("node budget");
+        }
+        let index = nodes.len();
+        nodes.push(NodeData {
+            typ: self.slot(&expression.typ)?,
+            data,
+        });
+        Ok(index)
+    }
+
+    fn encode(&self, contract: &Contract) -> CodecResult<Vec<u8>> {
+        let mut nodes = vec![];
+        let pre = self.encode_expression(&contract.pre, &mut nodes, 0)?;
+        let post = self.encode_expression(&contract.post, &mut nodes, 0)?;
+        let wire = Wire {
+            schema: SCHEMA.into(),
+            key: self.key.clone(),
+            dependencies: self.dependencies.clone(),
+            nodes,
+            pre,
+            post,
+        };
+        let bytes = serde_json::to_vec(&wire).map_err(|_| "serialization")?;
+        self.decode(&bytes)?;
+        Ok(bytes)
+    }
+
+    fn decode(&self, bytes: &[u8]) -> CodecResult<Contract> {
+        if bytes.is_empty() || bytes.len() > MAX_BYTES {
+            return Err("byte budget");
+        }
+        let wire: Wire = serde_json::from_slice(bytes).map_err(|_| "malformed wire data")?;
+        if wire.schema != SCHEMA || wire.key != self.key || wire.dependencies != self.dependencies {
+            return Err("schema, key or dependency mismatch");
+        }
+        if wire.nodes.is_empty() || wire.nodes.len() > MAX_NODES {
+            return Err("node budget");
+        }
+        if serde_json::to_vec(&wire).map_err(|_| "canonicalization")? != bytes {
+            return Err("noncanonical data or unknown fields");
+        }
+        let mut terms: Vec<Term> = vec![];
+        let mut depths: Vec<usize> = vec![];
+        let mut uses_result = vec![];
+        let span = &self.function.span;
+        for (index, node) in wire.nodes.iter().enumerate() {
+            let typ = self.types.get(node.typ).ok_or("unknown type slot")?;
+            let children = node.data.children();
+            if children.len() > 8 || children.iter().any(|child| *child >= index) {
+                return Err("forward, recursive or oversized node");
+            }
+            let depth = 1 + children
+                .iter()
+                .map(|child| depths[*child])
+                .max()
+                .unwrap_or(0);
+            let size = children
+                .iter()
+                .try_fold(1usize, |size, child| size.checked_add(terms[*child].size))
+                .ok_or("expanded size overflow")?;
+            if depth > MAX_DEPTH || size > MAX_EXPANDED {
+                return Err("expanded expression budget");
+            }
+            let term_at = |child: usize| terms[child].clone();
+            let expr_at = |child: usize| terms[child].expr.clone();
+            let expression = match &node.data {
+                Data::Bool(value) if matches!(&**typ, TypX::Bool) => {
+                    ExprX::Const(Constant::Bool(*value))
+                }
+                Data::Integer(decimal) => {
+                    if decimal.len() > 79 {
+                        return Err("integer size");
+                    }
+                    let value: BigInt = decimal.parse().map_err(|_| "invalid integer")?;
+                    if value.bits() > 256
+                        || value.to_string() != *decimal
+                        || !integer_fits(&value, typ)
+                    {
+                        return Err("integer type or canonicality");
+                    }
+                    ExprX::Const(Constant::Int(value))
+                }
+                Data::Parameter(slot) => {
+                    let parameter = self
+                        .function
+                        .x
+                        .params
+                        .get(*slot)
+                        .ok_or("unknown parameter slot")?;
+                    if !same(typ, &parameter.x.typ) {
+                        return Err("parameter type mismatch");
+                    }
+                    ExprX::Var(parameter.x.name.clone())
+                }
+                Data::Result => {
+                    if !same(typ, &self.function.x.inner_ret.x.typ) {
+                        return Err("result type mismatch");
+                    }
+                    ExprX::Var(self.function.x.inner_ret.x.name.clone())
+                }
+                Data::Unary(operator, operand) => {
+                    if !matches!(
+                        operator,
+                        UnaryOp::Not | UnaryOp::BitNot(_) | UnaryOp::Clip { .. }
+                    ) {
+                        return Err("unsupported unary operator");
+                    }
+                    let built = summary::unary(span, *operator, term_at(*operand))
+                        .map_err(|_| "unary type mismatch")?;
+                    if !same(typ, &built.expr.typ) {
+                        return Err("unary result mismatch");
+                    }
+                    built.expr.x.clone()
+                }
+                Data::Binary(
+                    operator @ (BinaryOp::Eq(Mode::Spec | Mode::Exec) | BinaryOp::Ne),
+                    left,
+                    right,
+                ) => {
+                    if !matches!(&**typ, TypX::Bool)
+                        || !same(&terms[*left].expr.typ, &terms[*right].expr.typ)
+                    {
+                        return Err("equality type mismatch");
+                    }
+                    ExprX::Binary(*operator, expr_at(*left), expr_at(*right))
+                }
+                Data::Binary(operator, left, right) => {
+                    let built = summary::binary(span, *operator, term_at(*left), term_at(*right))
+                        .map_err(|_| "binary type mismatch")?;
+                    if !same(typ, &built.expr.typ) {
+                        return Err("binary result mismatch");
+                    }
+                    built.expr.x.clone()
+                }
+                Data::Logical(operator, left, right) => {
+                    if !matches!(&**typ, TypX::Bool)
+                        || !matches!(&*terms[*left].expr.typ, TypX::Bool)
+                        || !matches!(&*terms[*right].expr.typ, TypX::Bool)
+                    {
+                        return Err("logical type mismatch");
+                    }
+                    ExprX::Logical(*operator, expr_at(*left), expr_at(*right))
+                }
+                Data::If(condition, yes, no) => {
+                    if !matches!(&*terms[*condition].expr.typ, TypX::Bool)
+                        || !same(typ, &terms[*yes].expr.typ)
+                        || !same(typ, &terms[*no].expr.typ)
+                    {
+                        return Err("conditional type mismatch");
+                    }
+                    ExprX::If(expr_at(*condition), expr_at(*yes), Some(expr_at(*no)))
+                }
+                Data::Constructor(variant, values) => {
+                    let layout = self.variant(typ, variant)?;
+                    if layout.len() != values.len()
+                        || layout
+                            .iter()
+                            .zip(values)
+                            .any(|((_, expected), value)| !same(expected, &terms[*value].expr.typ))
+                    {
+                        return Err("constructor arity or type");
+                    }
+                    let TypX::Datatype(datatype, ..) = &**typ else {
+                        return Err("constructor type");
+                    };
+                    let fields = layout
+                        .iter()
+                        .zip(values)
+                        .map(|((name, _), value)| {
+                            crate::ast_util::ident_binder(name, &expr_at(*value))
+                        })
+                        .collect();
+                    ExprX::Ctor(
+                        datatype.clone(),
+                        Arc::new(variant.clone()),
+                        Arc::new(fields),
+                        None,
+                    )
+                }
+                Data::Variant(variant, value) => {
+                    self.variant(&terms[*value].expr.typ, variant)?;
+                    if !matches!(&**typ, TypX::Bool) {
+                        return Err("variant result type");
+                    }
+                    let TypX::Datatype(datatype, ..) = &*terms[*value].expr.typ else {
+                        return Err("variant input type");
+                    };
+                    ExprX::UnaryOpr(
+                        UnaryOpr::IsVariant {
+                            datatype: datatype.clone(),
+                            variant: Arc::new(variant.clone()),
+                        },
+                        expr_at(*value),
+                    )
+                }
+                Data::Field(variant, field, value) => {
+                    let layout = self.variant(&terms[*value].expr.typ, variant)?;
+                    let (name, expected) = layout.get(*field).ok_or("unknown field")?;
+                    if !same(typ, expected) {
+                        return Err("field type mismatch");
+                    }
+                    let TypX::Datatype(datatype, ..) = &*terms[*value].expr.typ else {
+                        return Err("field input type");
+                    };
+                    ExprX::UnaryOpr(
+                        UnaryOpr::Field(FieldOpr {
+                            datatype: datatype.clone(),
+                            variant: Arc::new(variant.clone()),
+                            field: name.clone(),
+                            get_variant: false,
+                            check: VariantCheck::None,
+                        }),
+                        expr_at(*value),
+                    )
+                }
+                Data::Observation(slot, arguments) => {
+                    let observation = self
+                        .observations
+                        .get(*slot)
+                        .ok_or("unapproved observation slot")?;
+                    if !same(typ, &observation.x.inner_ret.x.typ)
+                        || arguments.len() != observation.x.params.len()
+                        || arguments.iter().zip(observation.x.params.iter()).any(
+                            |(argument, parameter)| {
+                                !same(&terms[*argument].expr.typ, &parameter.x.typ)
+                            },
+                        )
+                    {
+                        return Err("observation signature mismatch");
+                    }
+                    ExprX::Call {
+                        target: CallTarget::Fun(
+                            CallTargetKind::Static,
+                            observation.x.name.clone(),
+                            Arc::new(vec![]),
+                            Arc::new(vec![]),
+                            CallTargetAttrs {
+                                autospec: AutospecUsage::Final,
+                                const_var: false,
+                                assume_external_allowed: false,
+                            },
+                        ),
+                        args: Arc::new(
+                            arguments
+                                .iter()
+                                .map(|argument| expr_at(*argument))
+                                .collect(),
+                        ),
+                        post_args: None,
+                        body: None,
+                    }
+                }
+                _ => return Err("unsupported data or type"),
+            };
+            uses_result.push(
+                matches!(node.data, Data::Result)
+                    || children.iter().any(|child| uses_result[*child]),
+            );
+            terms.push(Term {
+                view: None,
+                expr: SpannedTyped::new(span, typ, expression),
+                size,
+            });
+            depths.push(depth);
+        }
+        let pre = terms.get(wire.pre).ok_or("invalid pre root")?;
+        let post = terms.get(wire.post).ok_or("invalid post root")?;
+        if uses_result[wire.pre] {
+            return Err("result in precondition");
+        }
+        let mut reachable = vec![false; wire.nodes.len()];
+        reachable[wire.pre] = true;
+        reachable[wire.post] = true;
+        for index in (0..wire.nodes.len()).rev() {
+            if reachable[index] {
+                for child in wire.nodes[index].data.children() {
+                    reachable[child] = true;
+                }
+            }
+        }
+        if reachable.iter().any(|used| !used) {
+            return Err("orphan data");
+        }
+        Contract::new(pre.expr.clone(), post.expr.clone()).map_err(|_| "nonboolean roots")
+    }
+}
+
+fn integer_fits(value: &BigInt, typ: &Typ) -> bool {
+    let positive = value >= &BigInt::from(0);
+    match &**typ {
+        TypX::Int(IntRange::Int) => true,
+        TypX::Int(IntRange::Nat) => positive,
+        TypX::Int(IntRange::U(bits)) => positive && value.bits() <= u64::from(*bits),
+        TypX::Int(IntRange::I(bits)) => {
+            let bound = BigInt::from(1) << (*bits - 1);
+            value >= &(-bound.clone()) && value < &bound
+        }
+        _ => false,
+    }
+}
