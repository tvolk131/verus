+    let (source, datatypes) = fixture();
+    let mut context = Context::new(&source, &datatypes, &[], &[], &policy()).unwrap();
+    let signed = Arc::new(TypX::Int(IntRange::I(8)));
+    context.add_type(&signed, &mut vec![]).unwrap();
+    for decimal in ["-128", "127"] {
+        let value = SpannedTyped::new(
+            &span(),
+            &signed,
+            ExprX::Const(Constant::Int(decimal.parse().unwrap())),
+        );
+        roundtrip(&context, equality(value.clone(), value));
