+    .expr;
+    roundtrip(&context, equality(clipped.clone(), clipped));
+    let logical = SpannedTyped::new(
+        &span(),
+        &bool_typ(),
+        ExprX::Logical(
+            LogicalOp::And,
+            boolean(&span(), true).expr,
