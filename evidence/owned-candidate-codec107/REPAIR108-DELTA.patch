+#[test]
+fn memoized_types_obey_the_combined_structural_depth_bound() {
+    let (source, datatypes) = fixture();
+    let mut context = Context::new(&source, &datatypes, &[], &[], &policy()).unwrap();
+    let mut nested = input("x").typ.clone();
+    for _ in 0..11 {
+        nested = named_type(CrateId::Core, &["option", "Option"], vec![nested]);
+        assert!(context.add_type(&nested, &mut vec![]).is_ok());
+    }
+    assert!(context.add_type(&nested, &mut vec![]).is_ok());
+    let too_deep = named_type(CrateId::Core, &["option", "Option"], vec![nested]);
+    assert_eq!(
+        context.add_type(&too_deep, &mut vec![]).err(),
+        Some("recursive or deep type")
+    );
+}
