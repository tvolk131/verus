+#[test]
+fn integer_boundaries_and_result_taint_under_conditionals() {
+    let (source, datatypes) = fixture();
+    let mut context = Context::new(&source, &datatypes, &[], &[], &policy()).unwrap();
+    let signed = Arc::new(TypX::Int(IntRange::I(8)));
+    context.add_type(&signed, &mut vec![]).unwrap();
+    for decimal in ["-128", "127"] {
+        let value = SpannedTyped::new(
+            &span(),
+            &signed,
+            ExprX::Const(Constant::Int(decimal.parse().unwrap())),
+        );
+        roundtrip(&context, equality(value.clone(), value));
+    }
+    for decimal in ["-129", "128"] {
+        let value = SpannedTyped::new(
+            &span(),
+            &signed,
+            ExprX::Const(Constant::Int(decimal.parse().unwrap())),
+        );
+        assert!(context
+            .encode(&Contract::new(equality(value.clone(), value), contract(&source).post).unwrap())
+            .is_err());
+    }
+    let bytes = context.encode(&contract(&source)).unwrap();
+    let mut wire: Wire = serde_json::from_slice(&bytes).unwrap();
+    let condition = wire.pre;
+    let result_test = wire.post;
+    let root = wire.nodes.len();
+    wire.nodes.push(NodeData {
+        typ: context.slot(&bool_typ()).unwrap(),
+        data: Data::If(condition, condition, result_test),
+    });
+    wire.pre = root;
+    assert_eq!(
+        context.decode(&serde_json::to_vec(&wire).unwrap()).err(),
+        Some("result in precondition")
+    );
+}
