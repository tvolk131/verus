+#[test]
+fn source_calls_use_resolved_targets_and_refuse_unknown_dispatch() {
+    let (source, datatypes) = value_enum_fixture();
+    let other = function("other_enum_source", input("x")).x.name.clone();
+    let cases = vec![
+        (CallTargetKind::Static, source.x.name.clone(), false),
+        (CallTargetKind::Static, other.clone(), true),
+        (CallTargetKind::Dynamic, other.clone(), false),
+        (CallTargetKind::ExternalTraitDefault, other.clone(), false),
+        (
+            CallTargetKind::ProofFn(Arc::new(vec![Mode::Proof]), Mode::Proof),
+            other.clone(),
+            false,
+        ),
+        (
+            CallTargetKind::DynamicResolved {
+                resolved: other,
+                typs: Arc::new(vec![]),
+                impl_paths: Arc::new(vec![]),
+                is_trait_default: false,
+            },
+            source.x.name.clone(),
+            true,
+        ),
+    ];
+    for (kind, nominal, accepted) in cases {
+        let mut definition = source.x.clone();
+        definition.body = Some(SpannedTyped::new(
+            &span(),
+            &source.x.inner_ret.x.typ,
+            ExprX::Call {
+                target: CallTarget::Fun(
+                    kind.clone(),
+                    nominal,
+                    Arc::new(vec![]),
+                    Arc::new(vec![]),
+                    CallTargetAttrs {
+                        autospec: AutospecUsage::Final,
+                        const_var: false,
+                        assume_external_allowed: false,
+                    },
+                ),
+                args: Arc::new(vec![input("x"), input("y")]),
+                post_args: None,
+                body: None,
+            },
+        ));
+        assert_eq!(
+            Context::new(&source.new_x(definition), &datatypes, &[], &[], &policy()).is_ok(),
+            accepted,
+            "{kind:?}"
+        );
+    }
+}
