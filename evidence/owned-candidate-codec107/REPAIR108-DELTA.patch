+#[test]
+fn positive_option_variant_projection_and_conditionals() {
+    let (source, datatypes) = fixture();
+    let context = Context::new(&source, &datatypes, &[], &[], &policy()).unwrap();
+    let option_type = context
+        .types
+        .iter()
+        .find(|typ| option(typ).is_some())
+        .unwrap();
+    let some = constructor(option_type, "Some", vec![("0", input("x"))]);
+    let none = constructor(option_type, "None", vec![]);
+    roundtrip(&context, equality(some.clone(), some.clone()));
+    roundtrip(&context, equality(none.clone(), none.clone()));
+    let TypX::Datatype(datatype, ..) = &**option_type else {
+        panic!("option")
+    };
+    let variant = SpannedTyped::new(
+        &span(),
+        &bool_typ(),
+        ExprX::UnaryOpr(
+            UnaryOpr::IsVariant {
+                datatype: datatype.clone(),
+                variant: Arc::new("Some".into()),
+            },
+            some.clone(),
+        ),
+    );
+    roundtrip(&context, variant.clone());
+    let payload = projection(&context, some.clone(), "Some", 0);
+    roundtrip(&context, equality(payload, input("x")));
+    let conditional = SpannedTyped::new(&span(), option_type, ExprX::If(variant, some, Some(none)));
+    roundtrip(&context, equality(conditional.clone(), conditional));
+    let record = source.x.body.clone().unwrap();
+    let outer_error = projection(&context, record, "Envelope", 0);
+    let inner_error = projection(&context, outer_error, "Err", 0);
+    let tuple = projection(&context, inner_error, "Err", 0);
+    let tuple_variant = context.shape(&tuple.typ).unwrap()[0].0.clone();
+    let second = projection(&context, tuple, &tuple_variant, 1);
+    roundtrip(&context, equality(second, input("y")));
+}
