+use super::*;
+
+fn equality(left: Expr, right: Expr) -> Expr {
+    SpannedTyped::new(
+        &span(),
+        &bool_typ(),
+        ExprX::Binary(BinaryOp::Eq(Mode::Spec), left, right),
+    )
+}
+
+fn roundtrip(context: &Context<'_>, expression: Expr) {
+    let proposed = Contract::new(expression, contract(context.function).post).unwrap();
+    let bytes = context.encode(&proposed).unwrap();
+    let decoded = context.decode(&bytes).unwrap();
+    assert_eq!(format!("{:?}", proposed.pre), format!("{:?}", decoded.pre));
+    assert_eq!(
+        format!("{:?}", proposed.post),
+        format!("{:?}", decoded.post)
+    );
+    assert_eq!(bytes, context.encode(&decoded).unwrap());
+}
+
+fn projection(context: &Context<'_>, value: Expr, variant: &str, field_index: usize) -> Expr {
+    let layout = context.variant(&value.typ, variant).unwrap();
+    let (name, field_type) = &layout[field_index];
+    let TypX::Datatype(datatype, ..) = &*value.typ else {
+        panic!("datatype")
+    };
+    SpannedTyped::new(
+        &span(),
+        field_type,
+        ExprX::UnaryOpr(
+            UnaryOpr::Field(FieldOpr {
+                datatype: datatype.clone(),
+                variant: Arc::new(variant.into()),
+                field: name.clone(),
+                get_variant: false,
+                check: VariantCheck::None,
+            }),
+            value,
+        ),
+    )
+}
+
+fn observation_definition() -> Function {
+    observation_from_body("review_observation", input("x"))
+}
+
+fn observation_from_body(name: &str, body: Expr) -> Function {
+    let return_type = body.typ.clone();
+    let base = function(name, body);
+    let mut definition = base.x.clone();
+    definition.mode = Mode::Spec;
+    definition.params = Arc::new(
+        definition
+            .params
+            .iter()
+            .map(|parameter| {
+                parameter.new_x(ParamX {
+                    mode: Mode::Spec,
+                    ..parameter.x.clone()
+                })
+            })
+            .collect(),
+    );
+    definition.inner_ret = definition.inner_ret.new_x(ParamX {
+        mode: Mode::Spec,
+        typ: return_type,
+        ..definition.inner_ret.x.clone()
+    });
+    definition.outer_ret = definition.inner_ret.clone();
+    Arc::make_mut(&mut definition.attrs).infer = false;
+    base.new_x(definition)
+}
+
+fn value_enum_fixture() -> (Function, Vec<Datatype>) {
+    let (source, datatypes) = fixture();
+    let mut declaration = datatypes[0].x.clone();
+    declaration.variants = Arc::new(vec![
