+#[test]
+fn sequential_observation_signatures_cannot_hide_memoized_type_depth() {
+    let (source, datatypes) = fixture();
+    let mut body = input("x");
+    let mut observations = vec![];
+    for depth in 1..=12 {
+        let nested = named_type(CrateId::Core, &["option", "Option"], vec![body.typ.clone()]);
+        body = constructor(&nested, "Some", vec![("0", body)]);
+        observations.push(observation_from_body(
+            &format!("nested_observation_{depth}"),
+            body.clone(),
+        ));
+    }
+    assert!(Context::new(&source, &datatypes, &observations[..11], &[], &policy()).is_ok());
+    assert_eq!(
+        Context::new(&source, &datatypes, &observations, &[], &policy()).err(),
+        Some("recursive or deep type")
+    );
+}
