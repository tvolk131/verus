+    .expr;
+    roundtrip(&context, equality(arithmetic.clone(), arithmetic));
+    let bitwise = summary::binary(
+        &span(),
+        BinaryOp::Bitwise(BitwiseOp::BitXor, BitshiftBehavior::Allow),
+        operand(),
+        operand(),
+    )
+    .unwrap()
+    .expr;
+    roundtrip(&context, equality(bitwise.clone(), bitwise));
+    let inverted = summary::unary(
