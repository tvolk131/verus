 struct Capture {
     program: Result<Program, String>,
     origins: HashMap<HirId, usize>,
+    unestablished_drop_sites: Vec<UnestablishedDropSite>,
+}
+
+#[derive(Clone, Debug)]
+struct UnestablishedDropSite {
+    block: usize,
+    cleanup: bool,
+    native_phase: bool,
+    mir_phase: String,
+    local: usize,
+    place: String,
+    projections: Vec<String>,
+    root_type: String,
+    binder_status: OriginCaptureStatus,
+    temporary_status: OriginCaptureStatus,
+    builder_origins: Vec<checked_drop_origins::TemporaryOrigin>,
+    destructor_identity_status: &'static str,
+    drop_glue_identity_status: &'static str,
+    normal_target: usize,
+    replace_assignment_origin: bool,
+    async_cancellation_cleanup_target: Option<usize>,
+    unwind_action: String,
+    unwind_cleanup_target: Option<usize>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum OriginCaptureStatus {
+    MissingCapture,
+    IncompleteCapture { observations: usize },
+    CompleteEmpty,
+    CompleteWithoutLocalMatch { observations: usize },
+    CompleteWithLocalMatches { observations: usize, matches: usize },
+}
+
+fn origin_status(observation: Option<(bool, usize, usize)>) -> OriginCaptureStatus {
+    match observation {
+        None => OriginCaptureStatus::MissingCapture,
+        Some((false, observations, _)) => OriginCaptureStatus::IncompleteCapture { observations },
+        Some((true, 0, _)) => OriginCaptureStatus::CompleteEmpty,
+        Some((true, observations, 0)) => OriginCaptureStatus::CompleteWithoutLocalMatch { observations },
+        Some((true, observations, matches)) => OriginCaptureStatus::CompleteWithLocalMatches { observations, matches },
+    }
+}
+
+#[cfg(test)]
+mod origin_capture_status_tests {
+    use super::{OriginCaptureStatus, origin_status};
+
+    #[test]
+    fn missing_capture_is_explicit() {
+        assert_eq!(origin_status(None), OriginCaptureStatus::MissingCapture);
+    }
+
+    #[test]
+    fn unfinished_capture_is_not_completed_capture() {
+        assert_eq!(origin_status(Some((false, 2, 1))),
+            OriginCaptureStatus::IncompleteCapture { observations: 2 });
+    }
+
+    #[test]
+    fn completed_empty_capture_is_not_missing() {
+        assert_eq!(origin_status(Some((true, 0, 0))), OriginCaptureStatus::CompleteEmpty);
+    }
+
+    #[test]
+    fn completed_capture_without_matching_local_is_explicit() {
+        assert_eq!(origin_status(Some((true, 2, 0))),
+            OriginCaptureStatus::CompleteWithoutLocalMatch { observations: 2 });
+    }
+
+    #[test]
+    fn matching_observations_do_not_establish_a_unique_occurrence() {
+        assert_eq!(origin_status(Some((true, 2, 2))),
+            OriginCaptureStatus::CompleteWithLocalMatches { observations: 2, matches: 2 });
+    }
+}
+
+fn unestablished_drop_sites<'tcx>(def: LocalDefId, body: &Body<'tcx>)
+    -> Vec<UnestablishedDropSite>
+{
+    let bindings = checked_drop_origins::get(def);
+    let temporaries = checked_drop_origins::get_temporaries(def);
+    let mut captured = Vec::new();
+    for (block, data) in body.basic_blocks.iter_enumerated() {
+        let TerminatorKind::Drop { place, target, unwind, replace, drop } = &data.terminator().kind else {
+            continue;
+        };
+        if bindings.as_ref().is_some_and(|origins| origins.iter().any(|(_, local)| *local == place.local)) {
+            continue;
+        }
+        let builder_origins = temporaries.as_ref().map(|capture| capture.origins.iter()
+            .filter(|origin| origin.local == place.local).cloned().collect::<Vec<_>>());
+        captured.push(UnestablishedDropSite {
+            block: block.as_usize(),
+            cleanup: data.is_cleanup,
+            native_phase: checked_drop_origins::native(),
+            mir_phase: format!("{:?}", body.phase),
+            local: place.local.as_usize(),
+            place: format!("{place:?}"),
+            projections: place.projection.iter().map(|projection| format!("{projection:?}")).collect(),
+            root_type: format!("{:?}", body.local_decls[place.local].ty),
+            binder_status: origin_status(bindings.as_ref().map(|origins|
+                (true, origins.len(), origins.iter().filter(|(_, local)| *local == place.local).count()))),
+            temporary_status: origin_status(temporaries.as_ref().map(|capture|
+                (capture.complete, capture.origins.len(), builder_origins.as_ref().map_or(0, |origins| origins.len())))),
+            builder_origins: builder_origins.unwrap_or_default(),
+            destructor_identity_status: "NOT_QUERIED_UNESTABLISHED_RESOURCE_EFFECTS",
+            drop_glue_identity_status: "NOT_QUERIED_NO_RESOLVED_INSTANCE_OR_SHIM_IDENTITY",
+            normal_target: target.as_usize(),
+            replace_assignment_origin: *replace,
+            async_cancellation_cleanup_target: drop.map(|target| target.as_usize()),
+            unwind_action: format!("{unwind:?}"),
+            unwind_cleanup_target: match unwind {
+                mir::UnwindAction::Cleanup(target) => Some(target.as_usize()),
+                _ => None,
+            },
+        });
+    }
+    captured
 }
 
