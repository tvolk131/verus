      "text": "set -eu\n. /tmp/tree-borrows-checked-foundation-20261110/env.sh\nopam init --bare --disable-sandboxing --no-setup default \"$TB_ROOT/repositories/opam-repository\"\nopam repository add coq-released \"$TB_ROOT/repositories/coq-released/released\" --all-switches\nopam repository add iris-dev \"$TB_ROOT/repositories/iris-dev\" --all-switches\nopam switch create tb ocaml-base-compiler.4.14.2 --jobs=2\n"
