      "text": "export TB_ROOT=/tmp/tree-borrows-checked-foundation-20261110\nexport OPAMROOT=\"$TB_ROOT/opamroot\"\nexport OPAMYES=1 OPAMJOBS=2 OPAMCONFIRMLEVEL=yes\nexport XDG_CACHE_HOME=\"$TB_ROOT/cache\"\nexport TMPDIR=\"$TB_ROOT/tmp\"\nexport PATH=\"$TB_ROOT/bin:$PATH\"\nexport PKG_CONFIG_PATH=\"$TB_ROOT/deps/lib/pkgconfig\"\nexport CFLAGS=\"-O2 -I$TB_ROOT/deps/include\"\nexport LDFLAGS=\"-L$TB_ROOT/deps/lib -Wl,-rpath,$TB_ROOT/deps/lib\"\nexport LD_LIBRARY_PATH=\"$TB_ROOT/deps/lib\"\n"
